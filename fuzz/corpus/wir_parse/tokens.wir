; the token chain is a spine: each store consumes its token and
; produces the successor; the loop threads it as a block parameter.
fn @fill(mut ptr, i64, i64, mem.r0) {
b0(%p: ptr, %n: i64, %v: i64, %m: mem.r0):
  %zero = iconst.i64 0
  jmp b1(%zero, %m)
b1(%i: i64, %t: mem.r0):
  %c = icmp.slt %i, %n
  br %c, b2, b3
b2:
  %addr = ptr.off %p, %i, 8
  %t2 = store.i64 %v, %addr, %t
  %one = iconst.i64 1
  %i2 = iadd.chk %i, %one
  jmp b1(%i2, %t2)
b3:
  ret
}
