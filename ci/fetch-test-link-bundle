#!/usr/bin/env python3
"""Reuse static-entry's pinned musl members and this checkout's musl runtime.

ci/fetch-entry-bundle verifies the published bundle and its members twice.
Its old libwolf_rt.a is never selected: CI builds the runtime with
cargo xtask dist-rt and exports WOLF_STATIC_ENTRY_MUSL_RT before this step.
"""
import hashlib
import os
import pathlib
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parent.parent
subprocess.run([sys.executable, str(root / "ci/fetch-entry-bundle"), *sys.argv[1:]], check=True)
rt = os.environ.get("WOLF_STATIC_ENTRY_MUSL_RT")
sysroot = os.environ.get("WOLF_STATIC_ENTRY_SYSROOT")
if not rt or not pathlib.Path(rt).is_file():
    raise SystemExit("REFUSED missing head-built musl runtime: build cargo xtask dist-rt and set WOLF_STATIC_ENTRY_MUSL_RT")
if not sysroot or not pathlib.Path(sysroot).is_dir():
    raise SystemExit("REFUSED missing verified musl sysroot: run ci/fetch-entry-bundle before this step")
for _ in range(2):
    with open(rt, "rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    print(f"{digest}  {rt}", flush=True)
if os.environ.get("GITHUB_ENV"):
    with open(os.environ["GITHUB_ENV"], "a") as env:
        env.write(f"WOLF_TEST_LIGATURE_RT={rt}\nLIGATURE_SYSROOT={sysroot}\n")
