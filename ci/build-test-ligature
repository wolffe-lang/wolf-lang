#!/usr/bin/env bash
# Build the pinned real linker. The strict test also needs the matching musl
# runtime and sysroot from ci/fetch-test-link-bundle (ligature#13).
# Optional WOLF supplies an already digest-verified complete 0.2.35 toolchain.
set -euo pipefail
pin=3f20641375d0493b5c62f802f435d624de172ede
root=$(git rev-parse --show-toplevel)
tree=${1:-$root/target/test-ligature}
# #966: a restored cache can leave .git hollow, making git answer the
# enclosing wolf-lang checkout instead. Clone the default tree again;
# refuse a caller-named tree without removing it.
own() {
    [ "$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$1" && pwd -P)" ]
}
if [ -d "$tree/.git" ] && ! own "$tree"; then
    if [ -n "${1:-}" ]; then
        echo "build-test-ligature: $tree has a .git that is not its own repository" >&2
        exit 1
    fi
    echo "build-test-ligature: $tree is not a checkout of its own (a restored cache); cloning it again"
    rm -rf "$tree"
fi
if [ ! -d "$tree/.git" ]; then
    git clone --no-checkout https://github.com/wolffe-lang/ligature.git "$tree"
    git -C "$tree" checkout --detach "$pin"
fi
head=$(git -C "$tree" rev-parse HEAD)
[ "$head" = "$pin" ] || { echo "build-test-ligature: $tree is at $head, not $pin" >&2; exit 1; }
git -C "$tree" diff --exit-code HEAD -- src tools wolf-toolchain.toml
if [ -z "${WOLF:-}" ]; then
    "$tree/tools/fetch-toolchain"
    WOLF="$tree/.wolf-bin/wolf"
fi
[ "$("$WOLF" --version | head -1)" = 'wolf 0.2.35 (wolfgang, pin cf0c13d)' ]
mkdir -p "$tree/target"
"$WOLF" build --deny-warnings "$tree/src/ligature.lu" -o "$tree/target/ligature"
sha256sum "$tree/target/ligature"
sha256sum "$tree/target/ligature"
if [ -n "${GITHUB_ENV:-}" ]; then
    printf 'WOLF_TEST_LIGATURE=%s/target/ligature\nWOLF_TEST_LIGATURE_REQUIRE=1\n' "$tree" >> "$GITHUB_ENV"
fi
