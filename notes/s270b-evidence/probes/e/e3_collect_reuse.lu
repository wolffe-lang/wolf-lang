//! member: false
// e3: c3 with the reuse done by growing the outer slot after the block (yew's collection:
// a push into a list whose header the freed block holds)
struct Slot {
    t: int,
    bytes: List[int],
}

struct Heap {
    slots: List[Slot],
}

fn alloc(mut h: Heap) -> int {
    (mut h.slots).push(Slot { t: -1, bytes: List[int]() })
    h.slots.len - 1
}

fn fill(n: int) -> int {
    var junk = List[int]()
    for i in 0..n { (mut junk).push(7777777) }
    junk.len
}

fn main() {
    var h = Heap { slots: List[Slot]() }
    var total = 0
    region scratch {
        let a = alloc(mut h)
        let b = alloc(mut h)
        for i in 0..100 { (mut h.slots[a].bytes).push(i) }
        total += fill(1000)
    }
    for j in 0..h.slots[0].bytes.len {
        let v = h.slots[0].bytes[j]
        (mut h.slots[1].bytes).push(v)
    }
    print("{h.slots.len} {h.slots[1].bytes.len} {h.slots[1].bytes[99]} {total}")
}
