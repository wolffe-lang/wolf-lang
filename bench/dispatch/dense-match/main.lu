//! Black-box witness (yw08, yew#77): does a `match` over 60 integer literal
//! arms dispatch in constant time on the release tier? Each op is read
//! from a 1,000,000-entry list (so the dispatch cannot be hoisted), the list
//! all arm 0, then all arm 30, then all arm 59; each arm adds a constant. Equal times mean a table; times growing with the arm's position
//! mean a compare chain, which is what a 57-arm interpreter `match` would
//! pay per instruction. Timing only; no generated code is read.

fn step(op: int, acc: int) -> int {
    var a = acc
    match op {
        0 => { a = a + 1 },
        1 => { a = a + 2 },
        2 => { a = a + 3 },
        3 => { a = a + 4 },
        4 => { a = a + 5 },
        5 => { a = a + 6 },
        6 => { a = a + 7 },
        7 => { a = a + 8 },
        8 => { a = a + 9 },
        9 => { a = a + 10 },
        10 => { a = a + 11 },
        11 => { a = a + 12 },
        12 => { a = a + 13 },
        13 => { a = a + 14 },
        14 => { a = a + 15 },
        15 => { a = a + 16 },
        16 => { a = a + 17 },
        17 => { a = a + 18 },
        18 => { a = a + 19 },
        19 => { a = a + 20 },
        20 => { a = a + 21 },
        21 => { a = a + 22 },
        22 => { a = a + 23 },
        23 => { a = a + 24 },
        24 => { a = a + 25 },
        25 => { a = a + 26 },
        26 => { a = a + 27 },
        27 => { a = a + 28 },
        28 => { a = a + 29 },
        29 => { a = a + 30 },
        30 => { a = a + 31 },
        31 => { a = a + 32 },
        32 => { a = a + 33 },
        33 => { a = a + 34 },
        34 => { a = a + 35 },
        35 => { a = a + 36 },
        36 => { a = a + 37 },
        37 => { a = a + 38 },
        38 => { a = a + 39 },
        39 => { a = a + 40 },
        40 => { a = a + 41 },
        41 => { a = a + 42 },
        42 => { a = a + 43 },
        43 => { a = a + 44 },
        44 => { a = a + 45 },
        45 => { a = a + 46 },
        46 => { a = a + 47 },
        47 => { a = a + 48 },
        48 => { a = a + 49 },
        49 => { a = a + 50 },
        50 => { a = a + 51 },
        51 => { a = a + 52 },
        52 => { a = a + 53 },
        53 => { a = a + 54 },
        54 => { a = a + 55 },
        55 => { a = a + 56 },
        56 => { a = a + 57 },
        57 => { a = a + 58 },
        58 => { a = a + 59 },
        59 => { a = a + 60 },
        _ => { a = a - 1 },
    }
    a
}

fn run(ops: List[int]) -> int {
    var acc = 0
    for op in ops { acc = step(op, acc) }
    acc
}

fn main() -> int {
    let n = 1000000
    for arm in [0, 30, 59] {
        var ops = List[int]()
        (mut ops).reserve(n)
        for _ in 0..n { (mut ops).push(arm) }
        var best = 0
        var result = 0
        for r in 0..10 {
            let t0 = os_clock_ns()
            result = run(ops)
            let ns = os_clock_ns() - t0
            if r == 0 || ns < best { best = ns }
        }
        print("arm={arm} result={result} best_ns={best} ns_per_op={best * 1000 / n}/1000")
    }
    0
}
