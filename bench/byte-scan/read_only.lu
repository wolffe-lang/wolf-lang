//! member: false
//! s200 (wolf-lang#411) micro-benchmark, the BASELINE: read the file named
//! by the first argument in 1 MiB chunks and sum the lengths. What the
//! other two programs cost above this is their scan.

fn main() -> int {
    // The file is the last argument (`env_args` answers the arguments
    // after the program's own name).
    let args = env_args()
    if args.len < 1 {
        return 2
    }
    let fd = fs_open(args[args.len - 1]) else |e| {
        return 3
    }
    var total = 0
    loop {
        region pass {
            let chunk = fs_read_chunk(fd, 1048576) else |e| match e {
                eof => { break },
                io => { return 4 },
            }
            total = total + chunk.len
        }
    }
    print("{total}")
    0
}
