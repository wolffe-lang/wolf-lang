//! member: false
//! s200 (wolf-lang#411) micro-benchmark, the LOOP a program could write
//! before s200: count the newlines of the file named by the first argument
//! with `for b in chunk` — boreutils' `wc -l` inner loop, verbatim.

fn main() -> int {
    // The file is the last argument (`env_args` answers the arguments
    // after the program's own name).
    let args = env_args()
    if args.len < 1 {
        return 2
    }
    let fd = fs_open(args[args.len - 1]) else |e| {
        return 3
    }
    var lines = 0
    loop {
        region pass {
            let chunk = fs_read_chunk(fd, 1048576) else |e| match e {
                eof => { break },
                io => { return 4 },
            }
            for b in chunk {
                if b as int == 10 {
                    lines += 1
                }
            }
        }
    }
    print("{lines}")
    0
}
