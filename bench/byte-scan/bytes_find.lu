//! member: false
//! s200 (wolf-lang#411) micro-benchmark, the LINE SPLITTER: the same count
//! walked hit to hit with `bytes_find` — what `head -n`, `cat -n` or a
//! tokenizer does — so its cost per line is on record beside the count's.

fn main() -> int {
    let args = env_args()
    if args.len < 2 {
        return 2
    }
    let fd = fs_open(args[1]) else |e| {
        return 3
    }
    var lines = 0
    let nl = 10 as byte
    loop {
        region pass {
            let chunk = fs_read_chunk(fd, 1048576) else |e| match e {
                eof => { break },
                io => { return 4 },
            }
            var at = 0
            loop {
                let hit = bytes_find(chunk, nl, at) else |e| { break }
                lines += 1
                at = hit + 1
            }
        }
    }
    print("{lines}")
    0
}
