// c2-ecs-sweep (family C) — sweep ONE hot field of a wide record.
// Same reworded thesis as aos_dot (report-10 amendment 4): layout-free
// internal ABI + SoA-as-idiom vs C's fixed AoS ABI. The record is 8 i64
// fields wide, so naive C touches one cache line per element to read one
// field; the SoA idiom touches one line per eight elements.
//
// Integer-typed so the correctness sink is exact in every lane.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for raw in first.bytes() {
        let b = raw as int
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn sweep(hot: List[int]) -> int {
    var acc = 0
    var i = 0
    while i < hot.len {
        acc = (acc + hot[i]) & 1048575
        i = i + 1
    }
    acc
}

fn main() -> !int {
    let ops = ops_arg(20)
    let n = 100000
    // The SoA idiom: the hot field gets its own container. The seven cold
    // fields of the C record would each get their own; this sweep never
    // touches them, and never pays for them.
    var hot = List[int]()
    var i = 0
    while i < n {
        (mut hot).push(i & 1023)
        i = i + 1
    }
    let t0 = time_now_ms()
    var sink = 0
    var k = 0
    while k < ops {
        sink = sweep(hot)
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * n},\"sink\":{sink}}}")
    0
}
