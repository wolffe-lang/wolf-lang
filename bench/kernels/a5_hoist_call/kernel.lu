// a5-hoist-call (family A) — CSE across an opaque WRITE (the #97
// redesign; s42's witness thesis, finally measured). `probe` reads
// `src[0]` on both sides of a call that stores through a DIFFERENT
// container. A `read` parameter is immutable for the whole call (spec
// 02 §7/O2) and a `mut` parameter is exclusive, so the c04 mode
// theorems prove `src` and `scratch` disjoint: wolf may reuse the
// first load and keep the running scratch value in a register. Naive
// C's pointers are laundered through volatile globals (ref.c), so the
// store may alias `src` and clang must reload — and store — every
// iteration. Expert C writes `restrict` by hand (expert.c).
//
// The s79→#97 history, so nobody reintroduces it: the original callee
// was a PURE self-recursion, and every lane solved it — clang folded
// the closed form and vectorized, wolf inlined and hoisted, and the
// kernel measured one folded arithmetic loop against another (0.16x of
// nothing). Three same-file fixes failed because a readnone callee is
// transparent whatever its shape; the opacity has to be a MEMORY WRITE
// the optimizer must respect. See bench/loss-ledger.md G7.
//
// The value chain keeps every store observable: `side` is the running
// scratch value folded into `acc`, and `acc` reaches the printed sink.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for raw in first.bytes() {
        let b = raw as int
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn bump(mut dst: List[int], x: int) -> int {
    dst[0] = (dst[0] + x) & 1023
    dst[0]
}

fn probe(src: List[int], mut scratch: List[int], n: int) -> int {
    var acc = 0
    var i = 0
    while i < n {
        let a = src[0]
        let side = bump(mut scratch, i)
        let b = src[0]
        acc = (acc + a + b + side) & 1048575
        i = i + 1
    }
    acc
}

fn main() -> !int {
    let ops = ops_arg(2000)
    let inner = 10000
    var src = List[int]()
    (mut src).push(7)
    (mut src).push(9)
    var scratch = List[int]()
    (mut scratch).push(0)
    (mut scratch).push(0)
    let t0 = time_now_ms()
    var sink = 0
    var k = 0
    while k < ops {
        sink = (sink + probe(src, mut scratch, inner)) & 1048575
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * inner},\"sink\":{sink}}}")
    0
}
