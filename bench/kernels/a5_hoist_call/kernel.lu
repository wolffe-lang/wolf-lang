// a5-hoist-call (family A) — the CSE-across-calls "holy grail" (s42's
// witness kernel, now scored). `probe` reads the same `read` parameter on
// both sides of an OPAQUE call. A `read` parameter is immutable for the
// whole call (spec 02 §7/O2), so the second load may be reused; C's
// callee could legally have written through a global alias, so naive C
// must reload. `expert.c` hoists the load by hand.
//
// `opaque` is self-recursive so nothing inlines it away in any lane.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for b in first.bytes() {
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn opaque(depth: int, x: int) -> int {
    if depth <= 0 { return x & 1023 }
    opaque(depth - 1, x + 1) & 1023
}

fn probe(src: List[int], n: int) -> int {
    var acc = 0
    var i = 0
    while i < n {
        let a = src[0]
        let side = opaque(1, i)
        let b = src[0]
        acc = (acc + a + b + side) & 1048575
        i = i + 1
    }
    acc
}

fn main() -> !int {
    let ops = ops_arg(2000)
    let inner = 10000
    var src = List[int]()
    (mut src).push(7)
    (mut src).push(9)
    let t0 = time_now_ms()
    var sink = 0
    var k = 0
    while k < ops {
        sink = (sink + probe(src, inner)) & 1048575
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * inner},\"sink\":{sink}}}")
    0
}
