// d2-substr-search (family D) — count occurrences of a 5-byte needle in a
// ~512 KiB haystack by sliding a zero-copy range slice and comparing.
// wolf's `s[i..j]` is a checked, zero-copy view (D25) and `==` on views is
// a length-guarded memcmp; naive C writes the same loop over `memcmp`.
//
// Deliberately NOT `strstr`/`str::find`: those are hand-vectorized library
// routines and comparing a hand loop to a tuned library is a benchmarking
// crime (bench/protocol.md, Heiser's checklist).
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for b in first.bytes() {
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn count_occurrences(hay: str, needle: str) -> int {
    var hits = 0
    var i = 0
    let last = hay.len - needle.len
    while i <= last {
        if hay[i..i + 5] == needle { hits = hits + 1 }
        i = i + 1
    }
    hits
}

fn main() -> !int {
    let ops = ops_arg(20)
    let chunk = "the pack moves at dusk and the wolf waits for nothing at all "
    let hay = chunk.repeat(9000)
    let t0 = time_now_ms()
    var sink = 0
    var k = 0
    while k < ops {
        sink = count_occurrences(hay, "wolf ")
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * hay.len},\"sink\":{sink}}}")
    0
}
