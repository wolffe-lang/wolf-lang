// word_count = d3-split-count (family D) — whitespace word count over a
// ~1 MiB buffer. wolf's `words()` hands back ZERO-COPY views into the
// buffer (D25), so the count is a byte scan with no per-word allocation;
// naive C writes the two-state byte scan by hand (ref.c).
//
// s84 is what made that sentence true. Until then `words()` built a
// `List[str]` — 72 000 pushes per call — and this kernel measured the
// allocation at 0.192x of naive C; `[mem.str.view]` makes the `for`
// head a walk over the receiver's own bytes and it now measures 0.935x.
// The `!w.is_empty()` filter below is kept deliberately: it is what a
// reader writes, and under `[mem.str.words]` (a word is never empty) it
// is provably dead, so it is also a small check that the clause and the
// lowering agree.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for b in first.bytes() {
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn count_words(text: str) -> int {
    var n = 0
    for w in text.words() {
        if !w.is_empty() { n = n + 1 }
    }
    n
}

fn main() -> !int {
    let ops = ops_arg(20)
    // 64-byte chunk x 16384 = 1 MiB, 4 words per chunk.
    let chunk = "the quick brown fox jumped over the lazy dogs again now  "
    let text = chunk.repeat(18000)
    let t0 = time_now_ms()
    var sink = 0
    var k = 0
    while k < ops {
        sink = count_words(text)
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * text.len},\"sink\":{sink}}}")
    0
}
