//! member: false
// ^ this file and `kernel.lu` are two standalone programs in one
// directory; without the opt-out, directory = module (D59) would
// merge their `main`s into one E0302.
// e2-checksum, WRAPPING variant (family E, X3 tracker). Identical
// arithmetic over `wrapping[int]`; the only difference from kernel.lu is
// that no overflow check exists.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for raw in first.bytes() {
        let b = raw as int
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn checksum(n: int, seed: int) -> int {
    var h = seed as wrapping[int]
    var i: wrapping[int] = 0
    let bound = n as wrapping[int]
    while i < bound {
        h = (h * 31 + (i & 255)) & 1048575
        i = i + 1
    }
    h as int
}

fn main() -> !int {
    let ops = ops_arg(4000)
    let inner = 100000
    let t0 = time_now_ms()
    var sink = 1
    var k = 0
    while k < ops {
        sink = checksum(inner, sink)
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * inner},\"sink\":{sink}}}")
    0
}
