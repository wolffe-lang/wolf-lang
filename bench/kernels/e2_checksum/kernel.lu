// e2-checksum (family E) — a rolling-hash/CRC-shaped loop: multiply,
// add, mask. Two checked ops per iteration (mul and add), both of which
// LLVM must keep as `llvm.smul/sadd.with.overflow` unless s42's range
// pass proves them away. `wrapping.lu` is the same loop with the checks
// gone; the delta is X3's price on a mul-carrying loop.
//
// The mask (`& 1048575`) is the fold that keeps the accumulator inside
// i64 in every lane, so all four lanes compute the SAME sink.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for b in first.bytes() {
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn checksum(n: int, seed: int) -> int {
    var h = seed
    var i = 0
    while i < n {
        h = (h * 31 + (i & 255)) & 1048575
        i = i + 1
    }
    h
}

fn main() -> !int {
    let ops = ops_arg(4000)
    let inner = 100000
    let t0 = time_now_ms()
    var sink = 1
    var k = 0
    while k < ops {
        sink = checksum(inner, sink)
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * inner},\"sink\":{sink}}}")
    0
}
