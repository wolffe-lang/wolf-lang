// aos_dot = c1-particles' reduction cousin (family C) — dot product over
// the hot field of 100k records.
//
// THESIS (reworded by report-10 amendment 4, the family-C honesty fix):
// "layout-free internal ABI + SoA-as-idiom vs C's fixed AoS ABI".
// wolf does NOT choose the layout for you at v1 — that is a post-v1
// campaign on I9's hooks. What wolf gives you is an internal ABI with no
// C struct-layout obligation, so writing the SoA idiom (one container per
// field) costs nothing at the boundary. Naive C pays the AoS stride tax
// (ref.c, what people write); expert C hand-rolls SoA (expert.c).
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for raw in first.bytes() {
        let b = raw as int
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn dot(ax: List[f64], bx: List[f64]) -> f64 {
    var acc = 0.0
    var i = 0
    while i < ax.len {
        acc = acc + ax[i] * bx[i]
        i = i + 1
    }
    acc
}

fn main() -> !int {
    let ops = ops_arg(20)
    let n = 100000
    // The SoA idiom: one container per hot field. The `y`/`z` fields of
    // the C record exist as their own containers and are never touched by
    // this sweep — which is the point.
    var ax = List[f64]()
    var bx = List[f64]()
    var va = 0.0
    var vb = 100000.0
    var i = 0
    while i < n {
        (mut ax).push(va)
        (mut bx).push(vb)
        va = va + 1.0
        vb = vb - 1.0
        i = i + 1
    }
    let t0 = time_now_ms()
    var sink = 0.0
    var k = 0
    while k < ops {
        sink = dot(ax, bx)
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * n},\"sink\":{sink}}}")
    0
}
