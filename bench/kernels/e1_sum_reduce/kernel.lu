//! member: false
// ^ this file and `wrapping.lu` are two standalone programs in one
// directory; without the opt-out, directory = module (D59) would
// merge their `main`s into one E0302.
// e1-sum-reduce (family E) — i64 summation with statically boundable
// ranges. X3's empirical defense: every wolf add is CHECKED in every
// profile, so this kernel prices the check. `wrapping.lu` is the same
// loop with `wrapping[int]`; the checked-vs-wrapping delta IS the X3
// overhead measurement the contract asks for.
//
// Protocol (bench/protocol.md): argv[1]=ops, prints
// {"ns":<self-timed>,"ops":<element count>,"sink":<value>}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for raw in first.bytes() {
        let b = raw as int
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn sum_reduce(n: int) -> int {
    var acc = 0
    var i = 0
    while i < n {
        // `&` deliberately, not `%`: the wrapping variant cannot lower
        // `%` (no idiv.wrap op), and a fair X3 delta needs the two
        // files to differ in the OVERFLOW CHECK and nothing else.
        acc = acc + (i & 1023)
        i = i + 1
    }
    acc
}

fn main() -> !int {
    let ops = ops_arg(4000)
    let inner = 100000
    let t0 = time_now_ms()
    var sink = 0
    var k = 0
    while k < ops {
        sink = sink % 4096 + sum_reduce(inner) % 4096
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * inner},\"sink\":{sink}}}")
    0
}
