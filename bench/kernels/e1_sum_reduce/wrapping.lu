// e1-sum-reduce, WRAPPING variant (family E, X3 tracker). Identical
// arithmetic with `wrapping[int]` accumulators, so no overflow check
// exists to eliminate. checked(kernel.lu) vs wrapping(this file) IS the
// X3 overhead number — nothing else about the two files differs.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for b in first.bytes() {
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn sum_reduce(n: int) -> int {
    var acc: wrapping[int] = 0
    var i: wrapping[int] = 0
    let bound = n as wrapping[int]
    while i < bound {
        acc = acc + (i & 1023)
        i = i + 1
    }
    acc as int
}

fn main() -> !int {
    let ops = ops_arg(4000)
    let inner = 100000
    let t0 = time_now_ms()
    var sink = 0
    var k = 0
    while k < ops {
        sink = sink % 4096 + sum_reduce(inner) % 4096
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * inner},\"sink\":{sink}}}")
    0
}
