// list_alloc = b1-tree-build-walk's linear cousin (family B) — build a
// 10k-node structure, walk it, tear it down, per sweep. wolf builds it in
// a region: bump allocation on the way in, WHOLESALE free on the way out
// (D12). Naive C mallocs and frees per node (ref.c); expert C hand-rolls
// an arena (expert.c). This is reports/01 fact 5 priced.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

struct Node { v: int, next: int }

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for raw in first.bytes() {
        let b = raw as int
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn build_walk(nodes: int) -> int {
    var sum = 0
    region arena {
        var xs = List[Node]()
        var i = 0
        while i < nodes {
            (mut xs).push(Node { v: i & 1023, next: i - 1 })
            i = i + 1
        }
        var idx = nodes - 1
        while idx >= 0 {
            let n = copy xs[idx]
            sum = (sum + n.v) & 1048575
            idx = n.next
        }
    }
    sum
}

fn main() -> !int {
    let ops = ops_arg(200)
    let nodes = 10000
    let t0 = time_now_ms()
    var sink = 0
    var k = 0
    while k < ops {
        sink = (sink + build_walk(nodes)) & 1048575
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * nodes},\"sink\":{sink}}}")
    0
}
