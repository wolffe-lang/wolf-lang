// e3-index-arith, WRAPPING variant (family E, X3 tracker). Same scaled
// index arithmetic with the overflow checks gone.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for b in first.bytes() {
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn walk(n: int, depth: int) -> int {
    var acc: wrapping[int] = 0
    var i: wrapping[int] = 0
    let bound = n as wrapping[int]
    while i < bound {
        acc = (acc + i * 8) & 1048575
        i = i + 1
    }
    var out = acc as int
    if depth > 0 { out = (out + walk(n, depth - 1)) & 1048575 }
    out
}

fn main() -> !int {
    let ops = ops_arg(2000)
    let inner = 100000
    let t0 = time_now_ms()
    var sink = 0
    var k = 0
    while k < ops {
        sink = (sink + walk(inner, 1)) & 1048575
        k = k + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops * inner * 2},\"sink\":{sink}}}")
    0
}
