// b3-request-churn (family B) — allocate-work-free per "request". wolf
// creates and destroys one scratch REGION per iteration; naive C does
// malloc/free per request (ref.c). The region create/free pair is a
// pointer bump and a pointer reset, which is the whole reports/01 fact-5
// argument in four lines.
//
// The corpus twin of this shape (corpus/kernels/churn_b3.lu) records that
// today's lowering SCALARIZES the scratch body, so the mid-end elides the
// region pair outright. Here the scratch allocation is a `List` inside the
// region, which the mid-end cannot elide — the allocation is real.
//
// Protocol: argv[1]=ops, prints {"ns":..,"ops":..,"sink":..}.

struct Req { id: int, size: int }

fn ops_arg(fallback: int) -> int {
    let args = env_args()
    let first = args.first() else { return fallback }
    var n = 0
    for raw in first.bytes() {
        let b = raw as int
        if b < 48 { return fallback }
        if b > 57 { return fallback }
        n = n * 10 + (b - 48)
    }
    if n == 0 { fallback } else { n }
}

fn serve(id: int) -> int {
    var out = 0
    region scratch {
        var buf = List[Req]()
        var j = 0
        while j < 16 {
            (mut buf).push(Req { id: id + j, size: (id + j) & 31 })
            j = j + 1
        }
        var t = 0
        while t < buf.len {
            out = (out + buf[t].size) & 65535
            t = t + 1
        }
    }
    out
}

fn main() -> !int {
    let ops = ops_arg(20000)
    let t0 = time_now_ms()
    var sink = 0
    var i = 0
    while i < ops {
        sink = (sink + serve(i)) & 1048575
        i = i + 1
    }
    let t1 = time_now_ms()
    let ns = (t1 - t0) * 1000000
    print("{{\"ns\":{ns},\"ops\":{ops},\"sink\":{sink}}}")
    0
}
