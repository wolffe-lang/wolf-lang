//! check: fail(E1010)
//! phase: typecheck
//! conforms: mem.region.escape, mem.tier0.move.3
//!
//! s227 (wolf-lang#660's door, no call at all): `copy d` is a fresh
//! allocation in the ambient region, and the `str` inside it still
//! names the original's bytes (`[mem.tier0.move.3]`: "the copy shares
//! them"). Trunk a027b643 built it and read freed bytes on native and release
//! (`ZZZZZZZZZZZZZZZZZZZZZ`, the chunk `other` reused), stale ones on the
//! checked machine; lupin traps `region-fault`.

struct Doc {
    title: str,
    n: int,
}

fn main() -> !int {
    let st = region()
    in st {
        let seq0 = 0
        var o = Doc { title: "", n: 0 }
        region pass {
            let s = "built in pass, {seq0} uses"
            let d = Doc { title: s, n: 1 }
            in st {
                o = copy d
            }
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{o.title}")
    }
    0
}
