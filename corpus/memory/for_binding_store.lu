//! check: run(exit=0, stdout="1 3\n")
//! phase: run
//! conforms: gram.pat.let, mem.iter.for, mem.model.value
//!
//! wolf-lang#1169: a `for` header's name holds its own value, a copy of
//! the element the walk yielded, never a place in the list
//! ([gram.pat.let]; the walk is over a copy of `rows`, [mem.iter.for]).
//! A store through it writes the copy and `rows` keeps `1 3`. Every
//! compiling machine wrote the store through to `rows` and printed `0 0`.

fn main() -> int {
    let rows = [[1, 2], [3, 4]]
    for row in rows {
        row[0] = 0
    }
    print("{rows[0][0]} {rows[1][0]}")
    0
}
