//! check: run(exit=0, stdout="1 3\n")
//! phase: run
//! conforms: gram.pat.let, mem.iter.for, mem.tier0.move.1
//!
//! wolf-lang#1169: `last = row` moves the `for` name's own copy out of
//! the loop, so the store through `last` after the loop leaves `rows` at
//! `1 3`. Every compiling machine wrote it into `rows[1]` and printed
//! `1 0`.

fn main() -> int {
    let rows = [[1, 2], [3, 4]]
    var last = [0]
    for row in rows {
        last = row
    }
    last[0] = 0
    print("{rows[0][0]} {rows[1][0]}")
    0
}
