//! check: run(exit=0, stdout="1 3\n")
//! phase: run
//! conforms: gram.pat.let, mem.iter.for, mem.tier0.move.1
//!
//! wolf-lang#1169: `let r = row` moves the `for` name's own copy into
//! `r`, so the store through `r` reaches nothing the loop walked and
//! `rows` keeps `1 3`. Every compiling machine wrote it through and
//! printed `0 0`.

fn main() -> int {
    let rows = [[1, 2], [3, 4]]
    for row in rows {
        let r = row
        r[0] = 0
    }
    print("{rows[0][0]} {rows[1][0]}")
    0
}
