//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.excl.1
//!
//! eg03 — `[mem.model.place.elem]` item 4, WHERE R2 FAILS: R2 holds
//! only for an index the body never writes. This body copies the loop
//! index into a `var` and writes the copy (`i = 0`), so `xs[i]` is
//! `xs[0]`: E1002 on every wolfgang lane. lupin 0.1.42 traps
//! `exclusivity`. The copy is there because a `for` header's own name
//! binds as `let` does (`[gram.pat.let]`, 2026-11-08), so the row's first
//! spelling, `i = 0` on the header's `i`, is now E0410 at the typecheck
//! rung and never reaches this check; `var i = i` is that rule's own fix,
//! and the index the claim reads is still one the body writes.

fn add2(mut a: int, mut b: int) {
    a = a + 1
    b = b + 10
}

fn main() -> !int {
    var xs = [1, 2, 3]
    for i in 1..3 {
        var i = i
        i = 0
        add2(mut xs[0], mut xs[i])  // ERROR E1002: the index is written in the body
    }
    print("{xs[0]} {xs[1]} {xs[2]}")
    0
}
