//! check: run(exit=0, stdout="key\nval\n7 1\nkey\nj\nval\n0 5\n")
//! phase: run
//! conforms: mem.model.place.rhs, mem.model.order, type.map
//!
//! s183 (wolf-lang#452, ruled index first, then value) — the `Map`
//! twin of `ctl_store_order.lu`. `m[key()] = val()` evaluates the key
//! before the right-hand side; `mm[key()][j()] = val()` evaluates the
//! key, then the list index, then the right-hand side — the place's
//! operands left to right, then the value, then the insert or the
//! element write. Same bytes on every machine; before s183 the
//! checked lane ran `val` first in both stores.

fn key() -> str {
    print("key")
    "a"
}

fn j() -> int {
    print("j")
    1
}

fn val() -> int {
    print("val")
    7
}

fn five() -> int {
    print("val")
    5
}

fn main() -> !int {
    var m = Map[str, int]()
    m[key()] = val()
    print("{m["a"] else 0} {m.len}")
    var mm = Map[str, List[int]]()
    mm["a"] = [0, 0]
    mm[key()][j()] = five()
    var row = mm["a"] else List[int]()
    print("{row[0]} {row[1]}")
    0
}
