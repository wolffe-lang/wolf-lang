//! check: run(exit=0, stdout="intact 0: bound 3 exceeded by the request, which asked for more rows than the table holds\n")
//! phase: run
//! conforms: mem.region.escape
//!
//! wolf-lang#1115's control: `inner`'s payload is a literal, whose bytes
//! are static and outlive every region, so the `?` out of `region r`
//! hands the caller nothing `r` owns. It runs, with the message intact,
//! on every machine. `region_try_payload_escape.lu` is the refusal.

fn inner(n: int) -> int ! {Failed(str)} {
    return Failed("bound 3 exceeded by the request, which asked for more rows than the table holds")
}

fn outer() -> int ! {Failed(str)} {
    var total = 0
    region r {
        let v = inner(3)?
        total += v
    }
    total
}

fn main() -> int {
    var msg = "none"
    let got = outer() else |e| match e {
        Failed(m) => {
            msg = m
            0
        },
    }
    for k in 0..8 {
        region q {
            let s = "YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY {k}"
            if s.len == 0 {
                print("never")
            }
        }
    }
    if msg.starts_with("bound 3 exceeded") {
        print("intact {got}: {msg}")
        return 0
    }
    print("changed {got}: {msg.len} bytes")
    3
}
