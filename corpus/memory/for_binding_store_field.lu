//! check: run(exit=0, stdout="1 3\n")
//! phase: run
//! conforms: gram.pat.let, gram.item.let, mem.iter.for, mem.model.value
//!
//! wolf-lang#1169 under a field: `r.items[0] = 0` stores into an element
//! reached through an index ([gram.item.let] leaves that legal) of the
//! `for` name's own copy, and `rows` keeps `1 3`. Every compiling machine
//! wrote it through and printed `0 0`.

struct Row { items: List[int] }

fn main() -> int {
    let rows = [Row { items: [1, 2] }, Row { items: [3, 4] }]
    for r in rows {
        r.items[0] = 0
    }
    print("{rows[0].items[0]} {rows[1].items[0]}")
    0
}
