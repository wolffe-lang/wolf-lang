//! check: run(exit=0, stdout="first: yss00=1 o=7\npop: zs=1 zs00=1 o=8\nelse-place: yss00=1 o=6\nmatch-binding: t0=1 o=4\nif-for: rows00=1 ss=9\nctor-for: rows00=1 es=5\nclosure-capture: yss00=1 o=9\nclosure-param: yss00=1 o=9\nmatch-temporary: yss00=1 o=9\nelse-payload: back=1 o=9\n")
//! phase: run
//! conforms: mem.region.edge.elem, mem.tier0.excl.1
//!
//! wolf-lang#1221 — a `push` stores as it is every operand nothing else
//! holds, and copies the rest. Each line pushes, writes through the pushed
//! element, and reads the value it came from.
//!
//! Stored as they are, and still no second path:
//! - `first`: an element `first` answers is a copy of its own (#1200).
//! - `pop`: the popped element has left the list.
//! - `if-for`, `ctor-for`: an `if` whose arms are literals, and an enum
//!   constructor, over a `for` binding. The push keeps them as they are, so
//!   the binding inside must be the loop's own copy (#1169's predicate).
//!
//! Still copied, each a value that may reach a place:
//! - `else-place`: an `else` whose fallback is a `read` parameter's element.
//! - `match-binding`: a `match` arm answering its pattern's binding of a
//!   `read` parameter.
//! - `closure-capture`: a fn value's answer (#1194).
//! - `closure-param`, `match-temporary`, `else-payload`: a declared function
//!   handed a list may still answer a piece of it (#1197, #1198, #1199), so
//!   its answer is copied until those are closed.

struct S {
    a: List[int],
}

enum E {
    Full(List[int]),
    Empty,
}

fn mk(xs: List[List[int]]) -> fn() -> List[int] {
    fn() xs[0]
}

fn via(xs: List[List[int]], f: fn(List[List[int]]) -> List[int]) -> List[int] {
    f(xs)
}

fn pick(xs: List[List[int]]) -> List[int] {
    match (xs[0], 1) {
        (a, n) => a,
    }
}

fn bad(take xs: List[int]) -> int ! {Bad(List[int])} {
    return Bad(xs)
}

fn lift(o: int ! {Bad(List[int])}) -> List[int] {
    let n = o else |e| match e {
        Bad(xs) => {
            return xs
        },
    }
    [n]
}

fn from_param(xs: List[List[int]]) -> int {
    var o = List[List[int]]()
    (mut o).push(xs.get(5) else xs[0])
    o[0][0] = 6
    o[0][0]
}

fn arm_of(t: (List[int], int)) -> int {
    var o = List[List[int]]()
    (mut o).push(match t {
        (a, n) => a,
    })
    o[0][0] = 4
    o[0][0]
}

fn main() -> int {
    let c = true
    var yss = [[1, 2], [3]]
    var o = List[List[int]]()

    (mut o).push(yss.first() else [9, 9])
    o[0][0] = 7
    print("first: yss00={yss[0][0]} o={o[0][0]}")

    var zs = [[1, 2], [3]]
    (mut o).push((mut zs).pop() else [0])
    o[1][0] = 8
    print("pop: zs={zs.len} zs00={zs[0][0]} o={o[1][0]}")

    let w = from_param(yss)
    print("else-place: yss00={yss[0][0]} o={w}")

    let t = ([1, 2], 1)
    let m = arm_of(t)
    print("match-binding: t0={t.0[0]} o={m}")

    var rows = [[1, 2], [3]]
    var ss = List[S]()
    for row in rows {
        (mut ss).push(if c { S { a: row } } else { S { a: [0] } })
    }
    ss[0].a[0] = 9
    print("if-for: rows00={rows[0][0]} ss={ss[0].a[0]}")

    var es = List[E]()
    for row in rows {
        (mut es).push(E.Full(row))
    }
    let back0 = match es[0] {
        Full(xs) => {
            xs[0] = 5
            xs[0]
        },
        Empty => 0,
    }
    print("ctor-for: rows00={rows[0][0]} es={back0}")

    let g = mk(yss)
    (mut o).push(g())
    o[2][0] = 9
    print("closure-capture: yss00={yss[0][0]} o={o[2][0]}")

    (mut o).push(via(yss, fn(v) v[0]))
    o[3][0] = 9
    print("closure-param: yss00={yss[0][0]} o={o[3][0]}")

    (mut o).push(pick(yss))
    o[4][0] = 9
    print("match-temporary: yss00={yss[0][0]} o={o[4][0]}")

    var src = [1, 2]
    let r = bad(take src)
    (mut o).push(lift(r))
    o[5][0] = 9
    let back = r else |e| match e {
        Bad(xs) => xs[0],
    }
    print("else-payload: back={back} o={o[5][0]}")
    0
}
