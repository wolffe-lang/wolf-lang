//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.tier0.excl.1, mem.tier0.mode.mut, mem.model.order
//!
//! s186 (wolf-lang#476) — the whole-claim twin of
//! `mut_claim_nested_read_elem.lu`: `grow(mut xs, total(xs))` reads
//! `xs` inside a nested call while the outer call holds `xs` `mut`.
//! The direct form (`grow(mut xs, xs)`) was always E1002; this one ran
//! `1 4` on checked, native and release through 0.2.19 while lupin
//! traps `exclusivity`.

fn grow(mut ys: List[int], n: int) {
    (mut ys).push(n)
}

fn total(ys: List[int]) -> int {
    ys.len
}

fn main() -> !int {
    var xs = [1, 2, 3]
    grow(mut xs, total(xs))  // ERROR E1002: xs read inside its own claim
    print("{xs[0]} {xs.len}")
    0
}
