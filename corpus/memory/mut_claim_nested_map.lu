//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.tier0.excl.1, mem.tier0.mode.mut, mem.model.order
//!
//! s186 (wolf-lang#476's rule, found by the lane) — the `Map` twin of
//! `mut_claim_nested_read_whole.lu`: `mput(mut m, msize(m))` lends the
//! whole map one call down inside its own claim. Ran `2` on checked,
//! native and release through 0.2.19; lupin traps `exclusivity`.

fn msize(m: Map[str, int]) -> int {
    m.len
}

fn mput(mut m: Map[str, int], n: int) {
    m["z"] = n
}

fn main() -> !int {
    var m = Map[str, int]()
    m["a"] = 1
    mput(mut m, msize(m))  // ERROR E1002: m read inside its own claim
    print("{m.len}")
    0
}
