//! check: run(exit=0, stdout="1 5\n")
//! phase: run
//! conforms: gram.pat.let, mem.iter.for, mem.model.value
//!
//! wolf-lang#1169 at depth: a store two indexes deep through a `for`
//! name writes the name's own copy, and `cube` keeps `1 5`. Every
//! compiling machine wrote it through and printed `0 0`.

fn main() -> int {
    let cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
    for plane in cube {
        plane[0][0] = 0
    }
    print("{cube[0][0][0]} {cube[1][0][0]}")
    0
}
