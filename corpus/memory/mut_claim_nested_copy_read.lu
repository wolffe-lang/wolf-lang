//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.tier0.excl.1, mem.model.order, mem.model.place.elem
//!
//! s186 (wolf-lang#476's rule, found by the lane) — a `Copy` read of
//! the claimed element itself, one call down. The same read spelled
//! directly (`bump(mut xs[0], xs[0])`) is D39's E1002; inside `id(…)`
//! it ran `2` on checked, native and release through 0.2.19, and lupin
//! traps `exclusivity`.

fn bump(mut a: int, n: int) {
    a = a + n
}

fn id(n: int) -> int {
    n
}

fn main() -> !int {
    var xs = [1, 2, 3]
    bump(mut xs[0], id(xs[0]))  // ERROR E1002: xs[0] read inside its own claim
    print("{xs[0]}")
    0
}
