//! check: run(exit=0, stdout="1 4 5 6")
//! phase: mem
//! conforms: gram.item.let
//!
//! D63 with a destructuring binder in the group: `(x, y) = pair()`
//! rides between two plain binders, and the binder after it reads a
//! destructured name. Honest through `mem` today — the lowering half
//! of destructuring bindings is #173 (c06); this file flips to
//! `phase: run` when it lands.

fn pair() -> (int, int) { (4, 5) }

fn main() -> !int {
    let a = 1, (x, y) = pair(), b = a + y
    print("{a} {x} {y} {b}")
    0
}
