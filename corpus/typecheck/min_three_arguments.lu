//! check: fail(E0402)
//! phase: resolve
//! conforms: type.min
//!
//! wolf-lang#708 (`[type.min]`): `min` takes exactly two operands; the
//! smallest of three is `min(min(a, b), c)`. Three is E0402 at the call.
//! lupin 0.1.60 prints `1`.

fn main() {
    print("{min(1, 2, 3)}") // ERROR E0402: `min` takes 2 arguments
}
