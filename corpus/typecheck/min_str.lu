//! check: fail(E0401)
//! phase: resolve
//! conforms: type.min
//!
//! wolf-lang#708 (`[type.min]`): `min` is the integer family's. A `str`
//! operand is E0401 at that operand; `a < b` orders two `str`s, and an
//! `if` picks one. lupin 0.1.60 declines it ("`min` takes integers").

fn main() {
    print("{min("b", "a")}") // ERROR E0401: `min` takes integers
}
