//! check: fail(E0401)
//! phase: resolve
//! conforms: type.min
//!
//! wolf-lang#708 (`[type.min]`): both operands have one integer type. A
//! `u8` beside an `i64` is E0401 at the second operand, which is checked
//! against the first's type; widen one with `as`. lupin 0.1.60 prints `3`.

fn main() {
    let a: u8 = 3
    let b: i64 = 4
    print("{min(a, b)}") // ERROR E0401: `min`'s operands are one integer type
}
