//! check: run(exit=0, stdout="81\n")
//! phase: run
//! conforms: type.int.shift
//!
//! wolf-lang#755 (s237): a function with no `if`, loop, call or index
//! is lowered as one block, and its locals are kept for that block
//! alone. A construct that branches in the middle of an expression ends
//! the block, so a local declared before it and read after it had no
//! definition: a plain `>>` by a count that is not a constant (the
//! count's check and the slow path past the width). Native and release
//! panicked at s237's head `822120f0`, the shift's own branches being
//! new there; trunk had no branch to split on, "use of a variable with
//! no definition on some path". The checked machine and lupin 0.1.52
//! printed what this row says.

fn f(x: int, n: int) -> int {
    let y = x + 1
    let z = x >> n
    y + z
}

fn main() {
    print("{f(64, 2)}")
}
