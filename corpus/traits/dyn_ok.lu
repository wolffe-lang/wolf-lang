//! check: run(exit=0)
//! phase: run
//! conforms: ty.trait.dyn.safe, ty.trait.dyn.dispatch
//!
//! A dyn-safe trait (receiver-only `Self`, no generics, no
//! associated escapes): the `dyn` object satisfies its own trait,
//! and sema records the dyn-safe method set for the interface.
//!
//! s96: both dispatch spellings LOWER — the qualified `Draw.draw(d)`
//! and the method `d.draw()` — each to the same chain: the pair
//! splits (data, vtable), the slot the trait's DynReport names loads,
//! and the call goes indirect with the erased signature
//! (`[abi.native.dyn]`). What `main` proves at run time is
//! compilation and linking of that chain, not its execution: nothing
//! CONSTRUCTS a dyn value yet — no coercion, cast, or unification
//! admits concrete → dyn — so `render`/`label` can never be called.
//! The construction rule is a filed surface decision; the executed
//! half of the ABI is pinned by the backends' dyn_dispatch exec
//! fixture, which hand-builds a one-slot vtable and exits through it.

trait Draw {
    fn draw(self) -> str
}

struct Dot {
    x: int,
}

impl Draw for Dot {
    fn draw(self) -> str {
        "dot"
    }
}

fn render(d: dyn Draw) -> str {
    Draw.draw(d)
}

fn label(d: dyn Draw) -> str {
    d.draw()
}

fn main() -> !int {
    0
}
