//! check: fail(E0701)
//! phase: resolve
//! conforms: comptime.sandbox, os.proc.pipe
//!
//! s215 (D33): `os_pipe` would make the COMPILER a descriptor — the `io`
//! category, refused at comptime with that category's reason.

comptime fn helper() -> int {
    let p = os_pipe() else |_| { (0, 0) }
    p.0
}

fn main() -> !int {
    const H = helper()
    H
}
