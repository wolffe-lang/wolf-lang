decl @collatz_steps(i64) -> i64

fn @collatz_steps(i64) -> i64 {
b0(%0: i64):
  %1 = iconst.i64 0
  jmp b1(%0, %1)
b1(%2: i64, %3: i64):
  %4 = iconst.i64 1
  %5 = icmp.eq %2, %4
  br %5, b2, b4
b2:
  jmp b3
b3:
