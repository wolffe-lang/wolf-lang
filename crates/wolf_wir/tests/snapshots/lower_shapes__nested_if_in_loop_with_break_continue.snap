  %6 = iconst.i64 2
  %7 = irem.chk %2, %6
  %8 = icmp.eq %7, %1
  br %8, b5, b6
b5:
  %9 = idiv.chk %2, %6
  jmp b7(%9)
b6:
  %10 = iconst.i64 3
  %11 = imul.chk %10, %2
  %12 = iadd.chk %11, %4
  jmp b7(%12)
b7(%13: i64):
  %14 = iadd.chk %3, %4
  jmp b1(%13, %14)
}

fn @main() -> i64 {
b0:
  %0 = iconst.i64 6
  %1 = call @collatz_steps(%0)
