---
decl @pick(bool, i64, i64) -> i64

fn @pick(bool, i64, i64) -> i64 {
b0(%0: bool, %1: i64, %2: i64):
  br %0, b1, b2
b1:
  jmp b3(%1)
b2:
  jmp b3(%2)
b3(%3: i64):
  ret %3
}

fn @main() -> i64 {
b0:
  %0 = bconst true
  %1 = iconst.i64 0
  %2 = iconst.i64 1
  %3 = call @pick(%0, %1, %2)
  ret %3
}
