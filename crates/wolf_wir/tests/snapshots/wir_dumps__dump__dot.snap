  br %8, b2, b3
b2:
  %9 = ptr.off %0, %6, 8
  %10 = load.f64 %9, %3
  %11 = ptr.off %1, %6, 8
  %12 = load.f64 %11, %3
  %13 = fma %10, %12, %7
  %14 = iconst.i64 1
  %15 = iadd.chk %6, %14
  jmp b1(%15, %13)
b3:
