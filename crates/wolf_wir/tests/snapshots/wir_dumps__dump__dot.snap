  fact deref %1 8x%2 : frozen.read
  fact noalias %0 %1 : excl.mut
b0(%0: ptr, %1: ptr, %2: i64, %3: mem.r0):
  %4 = iconst.i64 0
  %5 = fconst.f64 0x0000000000000000
