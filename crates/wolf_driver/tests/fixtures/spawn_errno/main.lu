//! s266 (wolf-lang#936, `[os.fs.error]`): what each spawn call and
//! `os_exec` answer — the row and `os_error()` — for each reason a
//! program cannot run. `spawn_errno_lanes.rs` stages the directory:
//! `busy` held open for writing, `bin` with no `#!` line, `nox` without
//! an execute bit, `dd` a directory, `p/noxcmd` a bare name's candidate
//! without an execute bit; `big` is 8 MiB of arguments, past linux's
//! ceiling at any stack limit (6 MiB) and macOS's `ARG_MAX`.

fn big_args() -> List[str] {
    var xs = List[str]()
    let word = "x".repeat(4096)
    for _ in 0..2048 {
        (mut xs).push(word)
    }
    xs
}

fn report(call: str, label: str, row: str) {
    let code = os_error()
    print("{call} {label}: {row} os_error {code} '{os_error_text(code)}'")
}

fn spawned(call: str, label: str, h: int) {
    let code = os_error()
    let st = os_wait_status(h) else -1
    print("{call} {label}: spawned os_error {code} status {st}")
}

fn via_spawn(label: str, path: str, args: List[str]) {
    var argv = List[str]()
    (mut argv).push(path)
    for a in args {
        (mut argv).push(a)
    }
    let h = os_spawn(argv) else |e| {
        report("os_spawn", label, "{e}")
        return
    }
    spawned("os_spawn", label, h)
}

fn via_with(label: str, path: str, args: List[str]) {
    let h = os_spawn_with(path, args, List[int]()) else |e| {
        report("os_spawn_with", label, "{e}")
        return
    }
    spawned("os_spawn_with", label, h)
}

fn via_fds(label: str, path: str, args: List[str]) {
    let h = os_spawn_fds(path, args, List[int]()) else |e| {
        report("os_spawn_fds", label, "{e}")
        return
    }
    spawned("os_spawn_fds", label, h)
}

fn via_job(label: str, path: str, args: List[str]) {
    let h = os_spawn_job(path, args, List[int](), 0, -1, 0) else |e| {
        report("os_spawn_job", label, "{e}")
        return
    }
    spawned("os_spawn_job", label, h)
}

fn via_exec(label: str, path: str, args: List[str]) {
    var argv = List[str]()
    (mut argv).push(path)
    for a in args {
        (mut argv).push(a)
    }
    os_exec(path, argv, List[str](), List[int]()) else |e| {
        report("os_exec", label, "{e}")
        return
    }
}

/// A bare name: the spawns search the probe's own `PATH` (the test sets
/// it to `./p:/usr/bin:/bin`) and `os_exec` the `PATH` it hands the new
/// program, the same list.
fn bare_row(label: str, name: str) {
    let none = List[str]()
    via_spawn(label, name, none)
    via_with(label, name, none)
    via_fds(label, name, none)
    via_job(label, name, none)
    var argv = List[str]()
    (mut argv).push(name)
    var env = List[str]()
    (mut env).push("PATH=./p:/usr/bin:/bin")
    os_exec(name, argv, env, List[int]()) else |e| {
        report("os_exec", label, "{e}")
        return
    }
}

fn row(label: str, path: str, args: List[str]) {
    via_spawn(label, path, args)
    via_with(label, path, args)
    via_fds(label, path, args)
    via_job(label, path, args)
    if label != "ok" {
        via_exec(label, path, args)
    }
}

fn main() {
    let none = List[str]()
    row("ok", "/usr/bin/true", none)
    row("missing", "./nope", none)
    row("noexec", "./bin", none)
    row("nox", "./nox", none)
    row("dir", "./dd", none)
    row("big", "/usr/bin/true", big_args())
    bare_row("bare-missing", "s266-no-such-program")
    bare_row("bare-nox", "noxcmd")
    // Last: where the host lets a file held open for writing run (macOS),
    // this row's `os_exec` succeeds and the probe is replaced.
    row("busy", "./busy", none)
}
