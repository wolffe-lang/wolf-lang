//! member: false
//! s245 (wolf-lang#778): the baseline — no import, nothing reached that
//! makes the signal hub or the readiness set. The gate compares the
//! descriptors the other programs hold at 3 and above (linux's
//! `/proc/self/fd`) with this program's, run the same way, so a
//! descriptor the runner leaks into every child cancels out. Report lines
//! as `imports_signal.lu`'s.

fn row(fd: int) -> str {
    let _ = fs_fstat(fd) else |_| {
        return "fd{fd} closed\n"
    }
    "fd{fd} open\n"
}

fn links() -> str {
    var out = "links"
    var fd = 0
    while fd < 16 {
        let r = fs_read_link("/proc/self/fd/{fd}") else |_| {
            fd += 1
            continue
        }
        out = out + " {fd}"
        fd += 1
    }
    out + "\n"
}

fn main() -> int {
    let args = env_args()
    if args.len < 1 {
        return 2
    }
    let text = row(0) + row(1) + row(2) + links()
    fs_write_text(args[0], text) else |_| {
        return 3
    }
    0
}
