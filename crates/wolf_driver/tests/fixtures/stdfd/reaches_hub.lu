//! member: false
//! s245 (wolf-lang#778): a program that REACHES the calls which make the
//! signal hub, so every tier makes it before `main` (ruling #80,
//! `[os.signal.hub]`). Started with a standard descriptor closed, the
//! hub's pipes must not take it: the closed one stays closed as the
//! program sees it, and the hub still works at the numbers it got (a
//! listen, a raise of the same meaning, a wait that answers it).
//! Report lines as `imports_signal.lu`'s, then `listen`, `raise`, `wait`.

fn row(fd: int) -> str {
    let _ = fs_fstat(fd) else |_| {
        return "fd{fd} closed\n"
    }
    "fd{fd} open\n"
}

fn links() -> str {
    var out = "links"
    var fd = 0
    while fd < 16 {
        let r = fs_read_link("/proc/self/fd/{fd}") else |_| {
            fd += 1
            continue
        }
        out = out + " {fd}"
        fd += 1
    }
    out + "\n"
}

fn main() -> int {
    let args = env_args()
    if args.len < 1 {
        return 2
    }
    var text = row(0) + row(1) + row(2) + links()
    var listen = "ok"
    os_signal_listen(1) else |_| {
        listen = "io"
    }
    text = text + "listen {listen}\n"
    if listen == "ok" {
        var raised = "ok"
        os_signal_raise(1) else |_| {
            raised = "io"
        }
        let m = os_signal_wait(1) else |_| 0 - 1
        text = text + "raise {raised}\nwait {m}\n"
    }
    fs_write_text(args[0], text) else |_| {
        return 3
    }
    0
}
