//! member: false
//! s245 (wolf-lang#778): the readiness set's twin of `reaches_hub.lu`.
//! The program reaches `net_accept` (a call that can park, so every tier
//! makes the readiness set before `main`, s239 `[os.net.reactor]`) on a
//! branch it never takes. Started with a standard descriptor closed, the
//! set's descriptors must not take it. Report lines as
//! `imports_signal.lu`'s.

fn row(fd: int) -> str {
    let _ = fs_fstat(fd) else |_| {
        return "fd{fd} closed\n"
    }
    "fd{fd} open\n"
}

fn links() -> str {
    var out = "links"
    var fd = 0
    while fd < 16 {
        let r = fs_read_link("/proc/self/fd/{fd}") else |_| {
            fd += 1
            continue
        }
        out = out + " {fd}"
        fd += 1
    }
    out + "\n"
}

fn main() -> int {
    let args = env_args()
    if args.len < 1 {
        return 2
    }
    if args.len > 99 {
        let c = net_accept(0) else |_| 0 - 1
        print("{c}")
    }
    let text = row(0) + row(1) + row(2) + links()
    fs_write_text(args[0], text) else |_| {
        return 3
    }
    0
}
