//! member: false
//! s245 (wolf-lang#778): `use std.net` and nothing reached that can
//! park (`net.loopback` builds a string) — the readiness set's twin of
//! `imports_signal.lu`. No tier makes the set, so a closed standard
//! descriptor stays closed. Report lines as `imports_signal.lu`'s, after
//! an `addr` line.

use std.net

fn row(fd: int) -> str {
    let _ = fs_fstat(fd) else |_| {
        return "fd{fd} closed\n"
    }
    "fd{fd} open\n"
}

fn links() -> str {
    var out = "links"
    var fd = 0
    while fd < 16 {
        let r = fs_read_link("/proc/self/fd/{fd}") else |_| {
            fd += 1
            continue
        }
        out = out + " {fd}"
        fd += 1
    }
    out + "\n"
}

fn main() -> int {
    let args = env_args()
    if args.len < 1 {
        return 2
    }
    let a = net.loopback(80)
    let text = "addr {a}\n" + row(0) + row(1) + row(2) + links()
    fs_write_text(args[0], text) else |_| {
        return 3
    }
    0
}
