//! member: false
//! s260 (wolf-lang#683, `[conc.proc.kill]` step 1) — `o.join()` of a
//! proc that ends after 1.5 s: until s260 the joiner's monitor wait
//! answered `cancelled` to its `else`.
//! The clause: the killed proc runs no further user code, so nothing it
//! would print after the park appears; the join answers `killed`.

fn other() -> int {
    time_sleep_ms(1500)
    5
}

fn parked() -> int {
    let o = spawn proc other()
    let v = o.join() else |_| {
        print("else-arm-ran")
        -1
    }
    print("after-park-ran {v}")
    0
}

fn main() -> !int {
    
    let w = spawn proc parked()
    time_sleep_ms(300)
    let t0 = time_now_ms()
    w.kill()
    let dt = time_now_ms() - t0
    var how = "normal"
    let _v = w.join() else |e| match e {
        killed => { how = "killed"; 0 },
        cancelled => { how = "cancelled"; 0 },
        error => { how = "error"; 0 },
        fault => { how = "fault"; 0 },
    }
    time_sleep_ms(100)
    let slow = if dt >= 1000 then "slow" else "prompt"
    print("join: {how}; kill {slow}")
    0
}
