//! member: false
//! s260 (wolf-lang#683, `[conc.proc.kill]` step 1) — a `when`
//! acquisition another task of the proc holds (inside its body, parked
//! in a receive).
//! The clause: the killed proc runs no further user code, so nothing it
//! would print after the park appears; the join answers `killed`.

fn parked() -> int {
    let m = Mutex(0)
    let n = Mutex(0)
    let gate = channel[int](0)
    scope s {
        s.spawn(fn() {
            when (m, n) {
                let _v = gate.recv() else |_| { return }
            }
        })
        time_sleep_ms(50)
        when (m, n) { m += 1 }
        print("after-acquire-ran")
    }
    print("after-park-ran")
    0
}

fn main() -> !int {
    
    let w = spawn proc parked()
    time_sleep_ms(300)
    let t0 = time_now_ms()
    w.kill()
    let dt = time_now_ms() - t0
    var how = "normal"
    let _v = w.join() else |e| match e {
        killed => { how = "killed"; 0 },
        cancelled => { how = "cancelled"; 0 },
        error => { how = "error"; 0 },
        fault => { how = "fault"; 0 },
    }
    time_sleep_ms(100)
    let slow = if dt >= 1000 then "slow" else "prompt"
    print("join: {how}; kill {slow}")
    0
}
