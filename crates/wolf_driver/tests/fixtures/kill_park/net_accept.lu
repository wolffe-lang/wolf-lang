//! member: false
//! s260 (wolf-lang#683, `[conc.proc.kill]` step 1) — a proc parked in
//! `net_accept` on a listener nobody dials.
//! The clause: the killed proc runs no further user code, so nothing it
//! would print after the park appears; the join answers `killed`.

fn parked(l: int) -> int {
    net_deadline(l, 60000) else |_| {}
    let c = net_accept(l) else |_| {
        print("else-arm-ran")
        -1
    }
    print("after-park-ran {c}")
    0
}

fn main() -> !int {
    let l = net_listen("127.0.0.1:0")?
    let w = spawn proc parked(l)
    time_sleep_ms(300)
    let t0 = time_now_ms()
    w.kill()
    let dt = time_now_ms() - t0
    var how = "normal"
    let _v = w.join() else |e| match e {
        killed => { how = "killed"; 0 },
        cancelled => { how = "cancelled"; 0 },
        error => { how = "error"; 0 },
        fault => { how = "fault"; 0 },
    }
    time_sleep_ms(100)
    let slow = if dt >= 1000 then "slow" else "prompt"
    print("join: {how}; kill {slow}")
    0
}
