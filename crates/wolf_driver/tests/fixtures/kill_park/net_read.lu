//! member: false
//! s260 (wolf-lang#683, `[conc.proc.kill]` step 1) — the issue's
//! witness (lobo's ws58): a proc parked in `net_read` with a 60 s
//! budget is killed; until s260 it came back on the read's failure arm
//! and wrote the pipe.
//! The clause: the killed proc runs no further user code, so nothing it
//! would print after the park appears; the join answers `killed`.

fn parked(sock: int, pipe: int) -> int {
    net_deadline(sock, 60000) else |_| {}
    let got = net_read(sock, 64) else |_| {
        "the-else-arm-ran"
    }
    net_write(pipe, "woke [{got}]\n") else |_| {}
    0
}

fn main() -> !int {
    let l = net_listen("127.0.0.1:0")?
    let p = net_port(l)?
    let cli = net_connect("127.0.0.1:{p}")?
    let srv = net_accept(l)?
    let pw = net_connect("127.0.0.1:{p}")?
    let pr = net_accept(l)?
    let w = spawn proc parked(srv, pw)
    time_sleep_ms(300)
    w.kill()
    var how = "normal"
    let _v = w.join() else |e| match e {
        killed => { how = "killed"; 0 },
        cancelled => { how = "cancelled"; 0 },
        error => { how = "error"; 0 },
        fault => { how = "fault"; 0 },
    }
    net_deadline(pr, 300) else |_| {}
    let stray = net_read(pr, 64) else |_| {
        "(nothing on the pipe)"
    }
    print("join: {how}; the pipe: {stray.trim()}")
    net_close(cli) else |_| {}
    0
}
