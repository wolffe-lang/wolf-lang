//! member: false
//! s290 (`[os.ready.wait]`, `[os.ready.set]`) — a meaning never hides the
//! entries. A meaning raised before the wait with a pipe ready: one answer
//! carries both, in both forms. `set` 0 never takes a meaning: the entry is
//! answered and the meaning stays queued for the poll. With nothing ready,
//! a sibling task's raise ends a park in both forms, well inside the
//! deadline. Then the race the registration closes, on the kernel-held
//! set: a sibling raises each time the waiter says it is about to wait,
//! 500 rounds with no deadline, each answered by the meaning; a lost wake
//! parks for ever and the harness's timeout is the red.

const USER: int = 512

fn main() -> !int {
    os_signal_listen(USER)?
    let p = os_pipe()?
    fs_write(p.1, "x")?
    os_signal_raise(USER)?
    let a = os_wait_ready([p.0], USER, -1)?
    print("one_shot_both: {a.0} {a.1}")
    let r = os_ready_open()?
    os_ready_set(r, p.0, 1, 3)?
    os_signal_raise(USER)?
    let b = os_ready_wait(r, USER, -1)?
    print("held_both: {b.0} {b.1}")
    os_signal_raise(USER)?
    let c = os_wait_ready([p.0], 0, 0)?
    let d = os_ready_wait(r, 0, 0)?
    let queued = os_signal_poll(USER)?
    print("set_zero: {c.0} {c.1} {d.0} {d.1} queued {queued}")
    let _x = fs_read_chunk(p.0, 1)?
    let t0 = os_clock_ns()
    var parked = List[int]()
    scope s {
        s.spawn(fn() {
            time_sleep_ms(50)
            os_signal_raise(USER)?
            time_sleep_ms(50)
            os_signal_raise(USER)?
            0
        })
        let e = os_wait_ready([p.0], USER, 5000)?
        (mut parked).push(e.0.len)
        (mut parked).push(e.1)
        let f = os_ready_wait(r, USER, 5000)?
        (mut parked).push(f.0.len)
        (mut parked).push(f.1)
    }
    let took = os_clock_ns() - t0
    print("sibling_raise: {parked} within {took < 4000000000}")
    let go = channel[int](0)
    var meanings = 0
    scope s {
        s.spawn(fn() {
            var i = 0
            while i < 500 {
                let n = go.recv()?
                os_signal_raise(USER)?
                i += n - n + 1
            }
            0
        })
        var round = 0
        while round < 500 {
            go.send(round)?
            let w = os_ready_wait(r, USER, -1)?
            if w.1 == USER && w.0.len == 0 {
                meanings += 1
            }
            round += 1
        }
    }
    print("race rounds=500 meanings={meanings}")
    os_ready_close(r)?
    fs_close(p.0)?
    fs_close(p.1)?
    0
}
