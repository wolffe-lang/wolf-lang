// s229 (wolf-lang#665): wolf-lang#665's witness, byte for byte: `fwd` is one line around `ch.send(s)`.
fn fwd(ch: channel[str], s: str) {
    ch.send(s) else {}
}

fn main() -> int {
    region st {
        let seq0 = 0
        let ch = channel[str](1)
        region pass {
            let s = "built in pass, {seq0} uses"
            fwd(ch, s)
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
