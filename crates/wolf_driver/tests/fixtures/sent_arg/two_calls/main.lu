// s229 (wolf-lang#665): through two calls.
fn fwd(ch: channel[str], s: str) {
    ch.send(s) else {}
}

fn outer(ch: channel[str], s: str) {
    fwd(ch, s)
}

fn main() -> int {
    region st {
        let seq0 = 0
        let ch = channel[str](1)
        region pass {
            let s = "built in pass, {seq0} uses"
            outer(ch, s)
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
