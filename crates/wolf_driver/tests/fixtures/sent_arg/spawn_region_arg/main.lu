// s229 (wolf-lang#678): wolf-lang#678's witness: a spawn proc argument built in a region block, no channel anywhere.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

fn main() -> int {
    let seq0 = 7
    region pass {
        let s = "built in pass, {seq0} uses"
        let _w = spawn proc child(s, 0)
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
