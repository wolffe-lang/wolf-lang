// s229 (wolf-lang#665): the call sits under `in st { }`.
fn fwd(ch: channel[str], s: str) {
    ch.send(s) else {}
}

fn main() -> int {
    let st = region()
    in st {
        let seq0 = 0
        let ch = channel[str](1)
        region pass {
            let s = "built in pass, {seq0} uses"
            in st {
                fwd(ch, s)
            }
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
