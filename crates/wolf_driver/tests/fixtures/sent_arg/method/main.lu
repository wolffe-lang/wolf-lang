// s229 (wolf-lang#665): a method on a struct holding the channel.
struct Out {
    ch: channel[str],
    n: int,
}
impl Out {
    fn emit(self, s: str) {
        self.ch.send(s) else { }
    }
}

fn main() -> int {
    let st = region()
    in st {
        let seq0 = 0
        let ch = channel[str](1)
        let o = Out { ch: ch, n: 0 }
        region pass {
            let s = "built in pass, {seq0} uses"
            o.emit(s)
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
