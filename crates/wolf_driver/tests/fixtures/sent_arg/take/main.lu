// s229 (wolf-lang#665): a `take` argument.
struct Doc {
    title: str,
    words: int,
}
fn fwd_t(ch: channel[str], take d: Doc) {
    ch.send(d.title) else { }
}

fn main() -> int {
    let st = region()
    in st {
        let seq0 = 0
        let ch = channel[str](1)
        region pass {
            let s = "built in pass, {seq0} uses"
            let d = Doc { title: s, words: 1 }
            fwd_t(ch, take d)
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
