// s229 (wolf-lang#678): a function handed the bytes as a parameter spawns and joins before it returns: sound, and accepted.
fn child(s: str, n: int) -> int {
    print("child sees: {s}")
    n
}

fn run(s: str) -> int {
    let w = spawn proc child(s, 0)
    w.join() else 1
}

fn main() -> int {
    let seq0 = 7
    region pass {
        let s = "built in pass, {seq0} uses"
        print("{run(s)}")
    }
    0
}
