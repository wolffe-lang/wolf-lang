// s229 (wolf-lang#665): a view of the region-built string.
fn fwd(ch: channel[str], s: str) {
    ch.send(s) else {}
}

fn main() -> int {
    region st {
        let seq0 = 0
        let ch = channel[str](1)
        region pass {
            let s = "built in pass, {seq0} uses"
            fwd(ch, s.trim())
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
