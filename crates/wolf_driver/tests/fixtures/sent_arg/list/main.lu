// s229 (wolf-lang#665): the bytes are reached through a `List[str]` argument.
fn fwd_first(ch: channel[str], xs: List[str]) {
    ch.send(xs[0]) else {}
}

fn main() -> int {
    region st {
        let seq0 = 0
        let ch = channel[str](1)
        region pass {
            let s = "built in pass, {seq0} uses"
            var xs = List[str]()
            (mut xs).push(s)
            fwd_first(ch, xs)
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
