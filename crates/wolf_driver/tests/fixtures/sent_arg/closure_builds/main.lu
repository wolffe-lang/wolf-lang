// s229 (wolf-lang#665): the closure builds its payload wherever it is called: in the callee's region block.
fn each(f: fn(int), n: int) {
    region inner {
        f(n)
    }
}

fn main() -> int {
    let seq0 = 0
    let ch = channel[str](1)
    each(fn(i: int) { ch.send("built in pass, {i} uses") else { } }, seq0)
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    print("{ch.recv() else "?"}")
    0
}
