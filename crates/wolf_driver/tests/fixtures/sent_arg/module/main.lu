// s229 (wolf-lang#665): a callee in another module: the rule reads the signature alone.
use sender

fn main() -> int {
    let st = region()
    in st {
        let seq0 = 0
        let ch = channel[str](1)
        region pass {
            let s = "built in pass, {seq0} uses"
            sender.fwd(ch, s)
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
