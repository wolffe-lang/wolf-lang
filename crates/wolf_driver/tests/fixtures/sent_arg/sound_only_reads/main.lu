// s229 (wolf-lang#665): the callee only READS the argument and sends a literal: sound, and refused — the rule reads the signature.
fn note(ch: channel[str], s: str) {
    print("{s.len}")
    ch.send("noted") else {}
}

fn main() -> int {
    region st {
        let seq0 = 0
        let ch = channel[str](1)
        region pass {
            let s = "built in pass, {seq0} uses"
            note(ch, s)
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
