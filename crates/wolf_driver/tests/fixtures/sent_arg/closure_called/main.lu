// s229 (wolf-lang#665): a closure that captured the channel, called in the region block.
fn main() -> int {
    region st {
        let seq0 = 0
        let ch = channel[str](1)
        let f = fn(x: str) { ch.send(x) else {} }
        region pass {
            let s = "built in pass, {seq0} uses"
            f(s)
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ch.recv() else "?"}")
    }
    0
}
