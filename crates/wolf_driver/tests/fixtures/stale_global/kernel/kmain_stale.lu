// s214 (wolf-lang#598): the freestanding witness. A kernel that keeps
// module state and storage `stale.S` reserves, written by callees
// between two reads. `kmain`'s result has one bit per shape read right;
// 31 is every shape:
//   1  a wolf writer (inlined on release),
//   2  a wolf writer two calls deep,
//   4  assembly writing `s214_cell` (a guard: an `extern "c"` call
//      threads the foreign tokens, so 0.2.24 was already right),
//   8  assembly calling back into wolf to write the `var` (a guard, the
//      same way),
//   16 a doubly recursive wolf writer (`walk` counts its 2^n leaves into
//      the `var`) to a depth the caller is given: no tier can fold it
//      or inline it away, so the call stays and the read must load.
// The three `export fn`s are the shapes the gate reads in the object
// with `objdump`: after the call, the storage is loaded again. At wolf
// 0.2.24 (294d626d) `s214_var_after_wolf_call` returned the caller's
// own 0 with no load after the call.
extern "c" let s214_cell: *i64

extern "c" fn s214_poke(v: i64)

extern "c" fn s214_call_back()

var v: int = 0

fn bump() {
    // # Safety: one CPU.
    unsafe {
        v = 99
    }
}

fn inner() {
    // # Safety: one CPU.
    unsafe {
        v = 7
    }
}

fn outer() {
    inner()
}

fn walk(n: int) {
    if n > 0 {
        walk(n - 1)
        walk(n - 1)
    } else {
        // # Safety: one CPU.
        unsafe {
            v += 1
        }
    }
}

export fn s214_var_after_wolf_call(depth: int) -> i64 {
    var r = 0
    // # Safety: one CPU.
    unsafe {
        v = 0
        walk(depth)
        r = v
    }
    r as i64
}

export fn s214_bump() {
    // # Safety: one CPU.
    unsafe {
        v = 42
    }
}

export fn s214_cell_after_call() -> i64 {
    var r: i64 = 0
    // # Safety: one CPU; s214_cell is stale.S's one i64.
    unsafe {
        s214_cell[0] = 0
        s214_poke(99)
        r = s214_cell[0]
    }
    r
}

export fn s214_var_after_callback() -> i64 {
    var r = 0
    // # Safety: one CPU.
    unsafe {
        v = 0
        s214_call_back()
        r = v
    }
    r as i64
}

export fn kmain() -> i64 {
    var bits = 0
    // # Safety: one CPU and nothing else running.
    unsafe {
        v = 0
        bump()
        if v == 99 {
            bits += 1
        }
        v = 0
        outer()
        if v == 7 {
            bits += 2
        }
    }
    if s214_cell_after_call() == 99 {
        bits += 4
    }
    if s214_var_after_callback() == 42 {
        bits += 8
    }
    if s214_var_after_wolf_call(2) == 4 {
        bits += 16
    }
    bits as i64
}
