// kw10 ([abi.interrupt], K7 = B, STATUS #31): an interrupt enters wolf
// through an assembly trampoline (isr.S) that builds a `#[repr(c)]`
// frame and calls `kw_interrupt`, an `export fn` under the C
// convention, then returns with `iretq`. The IDT is built here, in the
// .bss table isr.S reserves (`kw_idt`, named with `extern "c" let`:
// module state holds scalars only, [mem.static.3]), and loaded with
// LIDT. Then three exceptions, each of which must come back:
//
//   int3  vector 3, a trap: the saved RIP is past the int3
//         (kw_int3_after); the handler returns as is.
//   ud2   vector 6, a fault: the saved RIP is the ud2 (kw_ud2_at); the
//         handler moves it to kw_ud2_after.
//   #GP   vector 13, a fault with an error code: `mov %eax, %ds` of
//         selector 0x1234 at kw_gp_at, error code 0x1234; the handler
//         moves RIP to kw_gp_after.
//
// The kernel prints one line on COM1,
//
//   KWI frame 176 rip 136 vectors 3 6 13 error 0x1234 cs 0x8 ok
//
// (`size_of(Frame)`, `offset_of(Frame, rip)`, the vectors the handler
// saw in order, #GP's error code, the CS the CPU pushed) and returns
// 16 (QEMU exits 33), or 64 + the bits of what went wrong.
//
// The handler writes RIP through `f as *u64` at `offset_of(Frame, rip) / 8`:
// a store to a field of a raw element, `f[0].rip = v`, is refused on
// both compiling tiers ("assignment through this place shape").

extern "c" fn kw_outb(port: u16, v: u8)
extern "c" fn kw_lidt(idtr: *Idtr)
extern "c" fn kw_int3()
extern "c" fn kw_ud2()
extern "c" fn kw_gp()

extern "c" let kw_idt: *Gate
extern "c" let kw_idtr: *Idtr
extern "c" let kw_isr_table: *u64
extern "c" let kw_int3_after: *u8
extern "c" let kw_ud2_at: *u8
extern "c" let kw_ud2_after: *u8
extern "c" let kw_gp_at: *u8
extern "c" let kw_gp_after: *u8

/// What the trampoline hands the handler (isr.S's layout).
#[repr(c)]
struct Frame {
    r15: u64,
    r14: u64,
    r13: u64,
    r12: u64,
    r11: u64,
    r10: u64,
    r9: u64,
    r8: u64,
    rbp: u64,
    rdi: u64,
    rsi: u64,
    rdx: u64,
    rcx: u64,
    rbx: u64,
    rax: u64,
    vector: u64,
    error: u64,
    rip: u64,
    cs: u64,
    rflags: u64,
    rsp: u64,
    ss: u64,
}

/// A 64-bit IDT gate (Intel SDM vol. 3A §6.14.1, Figure 6-8).
#[repr(c)]
struct Gate {
    offset_lo: u16,
    selector: u16,
    ist: u8,
    attr: u8,
    offset_mid: u16,
    offset_hi: u32,
    reserved: u32,
}

/// LIDT's operand: a 16-bit limit, then the 64-bit base, no padding.
#[repr(c, packed)]
struct Idtr {
    limit: u16,
    base: u64,
}

const COM1: u16 = 1016

// The vectors the handler saw, one per decimal digit pair, in order
// (3, 6, 13 -> 30613); #GP's error code; the CS of the last frame;
// what went wrong, a bit each.
var seen: u64 = 0
var gp_error: u64 = 0
var last_cs: u64 = 0
var wrong: u64 = 0

/// The trampoline's target: the frame's address in %rdi.
export fn kw_interrupt(f: *Frame) {
    const RIP = offset_of(Frame, rip) / 8
    // # Safety: `f` is the trampoline's frame on the interrupted stack,
    // 176 bytes, live for this call; the module state is touched by one
    // CPU with interrupts off (an interrupt gate clears IF).
    unsafe {
        let v = f[0].vector
        let rip = f[0].rip
        let w = f as *u64
        if v == 3 {
            seen = seen * 100 + 3
            if rip != kw_int3_after as u64 {
                wrong = wrong | 1
            }
        } else if v == 6 {
            seen = seen * 100 + 6
            if rip != kw_ud2_at as u64 {
                wrong = wrong | 2
            }
            w[RIP] = kw_ud2_after as u64
        } else if v == 13 {
            seen = seen * 100 + 13
            gp_error = f[0].error
            if rip != kw_gp_at as u64 {
                wrong = wrong | 4
            }
            w[RIP] = kw_gp_after as u64
        } else {
            wrong = wrong | 8
        }
        last_cs = f[0].cs
    }
}

fn out(b: u8) {
    // # Safety: isr.S's OUT to COM1's transmit register.
    unsafe { kw_outb(COM1, b) }
}

fn put(s: str) {
    for b in s.bytes() {
        out(b as int as u8)
    }
}

fn dec(v: u64) {
    var p: u64 = 1
    while v / p >= 10 {
        p = p * 10
    }
    while p > 0 {
        out((v / p % 10 + 48) as u8)
        p = p / 10
    }
}

fn hex(v: u64) {
    put("0x")
    var shift: u64 = 64
    var started = false
    while shift > 0 {
        shift = shift - 4
        let d = (v >> shift) & 15
        if d != 0 || started || shift == 0 {
            started = true
            if d < 10 {
                out((d + 48) as u8)
            } else {
                out((d + 87) as u8)
            }
        }
    }
}

/// Gate `v` of the IDT: the trampoline at `at`, selector 0x08, an
/// interrupt gate (type 0xE), present, DPL 0, no IST.
fn set_gate(v: int, at: u64) {
    // # Safety: kw_idt is isr.S's 4096-byte table, 256 gates; v < 256.
    unsafe {
        kw_idt[v] = Gate {
            offset_lo: (at & 0xffff) as u16,
            selector: 8,
            ist: 0,
            attr: 0x8e,
            offset_mid: ((at >> 16) & 0xffff) as u16,
            offset_hi: ((at >> 32) & 0xffffffff) as u32,
            reserved: 0,
        }
    }
}

export fn kmain() -> i64 {
    // # Safety: isr.S's table of the three trampolines' addresses.
    unsafe {
        set_gate(3, kw_isr_table[0])
        set_gate(6, kw_isr_table[1])
        set_gate(13, kw_isr_table[2])
        kw_idtr[0] = Idtr { limit: 4095, base: kw_idt as u64 }
        kw_lidt(kw_idtr)
        kw_int3()
        kw_ud2()
        kw_gp()
    }
    // # Safety: the handler's state; interrupts are off and the
    // exceptions have all returned.
    let (s, e, cs, bad) = unsafe { (seen, gp_error, last_cs, wrong) }
    put("KWI frame ")
    dec(size_of(Frame) as u64)
    put(" rip ")
    dec(offset_of(Frame, rip) as u64)
    put(" vectors ")
    dec(s / 10000)
    put(" ")
    dec(s / 100 % 100)
    put(" ")
    dec(s % 100)
    put(" error ")
    hex(e)
    put(" cs ")
    hex(cs)
    if bad == 0 && s == 30613 && e == 0x1234 && cs == 8 {
        put(" ok\n")
        return 16
    }
    put(" WRONG ")
    hex(bad)
    put("\n")
    (64 + bad) as i64
}
