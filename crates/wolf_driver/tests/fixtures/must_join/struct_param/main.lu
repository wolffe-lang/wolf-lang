// s233 (wolf-lang#678, unsound, refused): the helper is handed a struct and spawns with its string field.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

struct Req {
    path: str,
    n: int,
}

fn helper(r: Req) {
    let _w = spawn proc child(r.path, r.n)
}

fn main() -> int {
    let seq0 = 7
    region pass {
        let r = Req { path: "built in pass, {seq0} uses", n: 0 }
        helper(r)
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
