// s233 (wolf-lang#678, unsound, refused): a method spawns with its receiver's string field and does not join.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

struct Req {
    path: str,
    n: int,
}

impl Req {
    fn start(self) {
        let _w = spawn proc child(self.path, self.n)
    }
}

fn main() -> int {
    let seq0 = 7
    region pass {
        let r = Req { path: "built in pass, {seq0} uses", n: 0 }
        r.start()
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
