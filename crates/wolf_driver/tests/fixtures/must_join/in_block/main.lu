// s233 (wolf-lang#678, unsound, refused): the call sits under in r { } with the bytes built in r.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

fn helper(s: str) {
    let _w = spawn proc child(s, 0)
}

fn main() -> int {
    let seq0 = 7
    if seq0 > 0 {
        let r = region()
        in r {
            let s = "built in r, {seq0} uses"
            helper(s)
        }
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
