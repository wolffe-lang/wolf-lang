// wolf-lang#1143, lobo's `run` shape: `run` waits on its proc's monitor with a timeout arm whose
// cleanup kills and joins the proc. A cancellation reaching that select runs the timeout arm,
// so the cleanup runs and `child` never reads `s` after `pass` is freed.
fn child(s: str, n: int) -> int {
    time_sleep_ms(400)
    print("child sees: {s}")
    n
}

fn end_body(w: Proc[int]) {
    w.kill()
    let _v = w.join() else |e| match e {
        killed => {
            0
        },
        cancelled => {
            0
        },
        error => {
            0
        },
        fault => {
            0
        },
    }
}

fn run(s: str) -> int {
    let w = spawn proc child(s, 0)
    let m = w.monitor()
    var cls = 3
    select {
        exit(reason) from m => {
            if reason.is_normal() {
                cls = 0
            } else {
                cls = 1
            }
        },
        timeout(5.s) => {
            cls = 4
        },
    }
    if cls == 4 {
        end_body(w)
    }
    cls
}

fn outer(n: int) -> int {
    region pass {
        let s = "built in pass, {n} uses"
        print("cls {run(s)}")
    }
    0
}

fn main() -> !int {
    let p = spawn proc outer(7)
    let pm = p.monitor()
    time_sleep_ms(100)
    p.cancel()
    select {
        exit(reason) from pm => {
            print("outer reason {reason}")
        },
    }
    time_sleep_ms(700)
    0
}
