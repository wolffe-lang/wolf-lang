// s233 (wolf-lang#678, unsound, refused): a trait method that leaves a proc running, called through a generic bound.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

trait Starter {
    fn start(self, s: str)
}

struct Kick {
    n: int,
}

impl Starter for Kick {
    fn start(self, s: str) {
        let _w = spawn proc child(s, self.n)
    }
}

fn go[T: Starter](t: T, s: str) {
    t.start(s)
}

fn main() -> int {
    let seq0 = 7
    let k = Kick { n: 0 }
    region pass {
        let s = "built in pass, {seq0} uses"
        go(k, s)
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
