// s233 (wolf-lang#678, unsound, refused): spawned each iteration, only the last joined.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

fn helper(s: str) -> int {
    var w = spawn proc child("a literal", 9)
    for i in 0..3 {
        w = spawn proc child(s, i)
    }
    w.join() else 1
}

fn main() -> int {
    let seq0 = 7
    region pass {
        let s = "built in pass, {seq0} uses"
        print("{helper(s)}")
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
