// s233 (wolf-lang#678, unsound, refused): the unjoined helper called through a fn value.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

fn helper(s: str) {
    let _w = spawn proc child(s, 0)
}

fn main() -> int {
    let seq0 = 7
    let h: fn(str) = helper
    region pass {
        let s = "built in pass, {seq0} uses"
        h(s)
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
