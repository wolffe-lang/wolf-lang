// s233 (wolf-lang#678, unsound, refused): the helper joins its proc, but that proc spawns a grandchild with its parameter and does not join it.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

fn mid(s: str, n: int) -> int {
    let _w = spawn proc child(s, n)
    n
}

fn helper(s: str) -> int {
    let w = spawn proc mid(s, 0)
    w.join() else 1
}

fn main() -> int {
    let seq0 = 7
    region pass {
        let s = "built in pass, {seq0} uses"
        print("{helper(s)}")
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
