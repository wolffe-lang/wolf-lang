// s233 (wolf-lang#678, sound, accepted): the helper spawns with scalars only and does not join.
fn child_n(n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {n}")
    n
}

fn helper(n: int) {
    let _w = spawn proc child_n(n)
}

fn main() -> int {
    let seq0 = 7
    region pass {
        let s = "built in pass, {seq0} uses"
        helper(s.len)
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
