// s233 (wolf-lang#678, unsound, refused): a closure spawns with its parameter and does not join.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

fn main() -> int {
    let seq0 = 7
    let f = fn(x: str) {
        let _w = spawn proc child(x, 0)
    }
    region pass {
        let s = "built in pass, {seq0} uses"
        f(s)
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
