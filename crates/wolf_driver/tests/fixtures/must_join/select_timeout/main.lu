// s233 (wolf-lang#678, unsound, refused): the timeout arm returns without a join.
fn child(s: str, n: int) -> int {
    time_sleep_ms(300)
    print("child sees: {s}")
    n
}

fn run(s: str) -> int {
    let w = spawn proc child(s, 0)
    let m = w.monitor()
    var cls = 3
    select {
        exit(reason) from m => {
            cls = 0
        },
        timeout(50.ms) => {
            cls = 4
        },
    }
    cls
}

fn main() -> int {
    let seq0 = 7
    region pass {
        let s = "built in pass, {seq0} uses"
        print("cls {run(s)}")
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
