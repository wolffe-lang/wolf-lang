// s233 (wolf-lang#678, unsound, refused): the helper is in another module.
use spawner

fn main() -> int {
    let seq0 = 7
    region pass {
        let s = "built in pass, {seq0} uses"
        spawner.helper(s)
    }
    region other {
        let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
        print("{z.len}")
    }
    time_sleep_ms(700)
    0
}
