//! member: false
//! s254 (wolf-lang#820, `[os.fs.mkfifo]`; yew yw02 G32, the serial test's
//! FIFO) — `fs_mkfifo(path, perm)`: `mkfifo(3)`, the bits less the umask
//! (set to 022 here, so 0600 stays 0600). Rows: made; `fs_stat` kind 4 and
//! its bits; made again `exists`; a missing parent `not_found`; bits past
//! 0777 `invalid`, before the host. Then `[os.fs.open]`'s mode 5 on it,
//! the row the language could not build before: the open answers at once
//! with no writer, `fs_fstat` calls it kind 2 and `fs_fstat_record` kind 4,
//! a read is `eof`; a writer opened after it, one write, and the reader
//! reads it. windows answers `unsupported` by name.

fn make(p: str, perm: int) -> str {
    fs_mkfifo(p, perm) else |e| {
        return match e {
            denied => "denied",
            exists => "exists",
            invalid => "invalid",
            io => "io",
            not_found => "not_found",
            unsupported => "unsupported",
        }
    }
    "ok"
}

fn main() -> !int {
    if fs_exists("ff") {
        fs_remove("ff")?
    }
    let old = os_umask(18) else |e| 0
    let made = make("ff", 384)
    print("made={made}")
    print("again={make("ff", 384)}")
    print("missing_parent={make("ff-none/x", 384)}")
    print("perm512={make("ff2", 512)}")
    print("negative={make("ff2", -1)}")
    if made == "ok" {
        let st = fs_stat("ff")?
        print("stat_kind={st[0]} bits={st[4] & 511}")
        let r = fs_open_mode("ff", 5)?
        let k = fs_fstat(r)?
        let rec = fs_fstat_record(r)?
        print("open_nonblock=ok fstat_kind={k[0]} record_kind={rec[0]}")
        let first = fs_read_chunk(r, 16) else |e| match e {
            eof => [101 as byte, 111 as byte, 102 as byte],
            io => [105 as byte, 111 as byte],
        }
        print("no_writer_read={str_from_utf8(first) else "?"}")
        let w = fs_open_mode("ff", 1)?
        fs_write(w, "x")?
        let got = fs_read(r, 16)?
        print("read_back={got}")
        fs_close(w)?
        fs_close(r)?
        fs_remove("ff")?
    }
    let _ = os_umask(old) else |e| 0
    0
}
