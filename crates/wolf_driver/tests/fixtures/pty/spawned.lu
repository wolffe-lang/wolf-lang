//! member: false
//! s292 (`[os.term.pty]`, `[os.term.size.set]`, `[os.term.attr]`) — on
//! every machine, the checked one included: the documented order with a
//! spawn in place of the fork. The pair is sized and VINTR set to Ctrl-G
//! before the child exists; `os_spawn_session` starts the compiled helper
//! (its path in the file `s292.helper`: the checked machine is handed no
//! arguments) with the slave on its standard streams and the slave's name
//! as its argument; the parent closes its slave, resizes on the master
//! (heard), sets the same size (not heard), a pixel-only change (heard),
//! then writes 0x07, which interrupts the child.

fn count(hay: str, needle: str) -> int {
    let h = hay.bytes()
    let n = needle.bytes()
    var found = 0
    var i = 0
    while i + n.len <= h.len {
        var j = 0
        while j < n.len && h[i + j] == n[j] {
            j = j + 1
        }
        if j == n.len {
            found = found + 1
        }
        i = i + 1
    }
    found
}

// Reads the master until `needle` has shown `times` times or `ms` pass.
// The wait's set must not be empty (`[os.signal.wait.fds]`); the parent
// listens for nothing, so INTERRUPT never answers it.
fn read_until(m: int, text: str, needle: str, times: int, ms: int) -> !str {
    var t = text
    var left = ms
    while count(t, needle) < times && left > 0 {
        let (i, _mm) = os_signal_wait_fds([m], 16, 100)?
        if i == 0 {
            let b = fs_read_chunk(m, 4096) else |_| List[byte]()
            t = "{t}{str_from_utf8(b) else ""}"
        }
        left = left - 100
    }
    t
}

fn main() -> !int {
    let helper = fs_read_text("s292.helper")?
    let (m, s) = os_term_open_pty()?
    let name = os_term_pty_name(m)?
    os_term_set_size(m, 24, 80, 0, 0)?
    os_term_set_attr(s, 1, 7)?
    let h = os_spawn_session(helper, [name], [0, s, 1, s, 2, s], 0)?
    fs_close(s)?
    var t = read_until(m, "", "ready 24 80", 1, 5000)?
    print("spawned: the child ready at the size set before it {count(t, "ready 24 80 foreground true") == 1}")
    os_term_set_size(m, 40, 132, 0, 0)?
    t = read_until(m, t, "resize 40 132", 1, 3000)?
    os_term_set_size(m, 40, 132, 0, 0)?
    t = read_until(m, t, "resize", 2, 500)?
    print("spawned: a new size heard {count(t, "resize 40 132")}, the same size again heard {count(t, "resize") - 1}")
    os_term_set_size(m, 40, 132, 8, 16)?
    t = read_until(m, t, "resize", 2, 3000)?
    print("spawned: a pixel-only change heard {count(t, "resize") == 2}")
    fs_write_chunk(m, [7 as byte])?
    t = read_until(m, t, "interrupted after 2", 1, 3000)?
    let st = os_wait_status(h)?
    print("spawned: Ctrl-G interrupts {count(t, "interrupted after 2") == 1}, status {st}")
    fs_close(m)?
    0
}
