// s245 (wolf-lang#777): s244's witness, byte for byte below this
// header (kasumi ~/lanes/s244-bigw-witness.lu, sha256 749a4df3…0b696d).
// main writes 8 MiB to a spawned task that accepts and reads; the
// checked machine's blocking write held the only running thread, so
// the reader never ran.
fn main() -> !int {
    let door = net_listen("127.0.0.1:0")?
    let port = net_port(door)?
    var big = "x"
    var i = 0
    while i < 23 {
        big = big + big
        i = i + 1
    }
    var got = 0
    scope s {
        s.spawn(fn() {
            let c = net_accept(door) else |_| 0 - 1
            var n = 0
            while n < 8388608 {
                let part = net_read(c, 65536) else |_| ""
                if part.len == 0 { n = 8388608 } else { n = n + part.len }
            }
        })
        let cli = net_connect("127.0.0.1:{port}")?
        net_write(cli, big)?
        net_close(cli)?
        got = big.len
    }
    print("wrote {got} bytes to a task")
    0
}
