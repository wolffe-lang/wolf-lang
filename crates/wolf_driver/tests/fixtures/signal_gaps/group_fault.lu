//! member: false
//! s246 (wolf-lang#783, `[os.signal.disp.one]`) — what GNU `timeout -s
//! SEGV` and `-s RTMIN` do without `--foreground`: lead a group, ignore
//! the signal it is about to send, send it to the whole group (itself
//! included), and live. RUN ONLY INSIDE A THROWAWAY CONTAINER (linux) OR
//! ON CI'S THROWAWAY RUNNER (macOS): it signals only the group it leads
//! (a `sleep` it started, and itself).
//!
//! Until s246 `os_signal_ignore` took the twenty listenable meanings only,
//! so the program could not ignore `SEGMENT_FAULT` or a host number, and a
//! group send of either ended it (boreutils' `timeout` refused both, exit
//! 125). The job's end is printed as its signal's number only (a core is
//! `core.lu`'s question), and `s246.rt` (a file in the working
//! directory) is the host's first real-time number, or 0 where it has
//! none (macOS).

/// One setting the test wrote beside the program, `s246.<name>` in the
/// working directory (not the environment: lupin's `conform-run` answers
/// `missing` for every variable), or "" when there is none.
fn conf(name: str) -> str {
    fs_read_text("s246.{name}") else |_| ""
}

fn masks() {
    let text = fs_read_text("/proc/self/status") else |_| ""
    for line in text.split("\n") {
        if line.starts_with("SigBlk:") || line.starts_with("SigIgn:") {
            eprint(line.replace("\t", " "))
        }
    }
}

fn signal_of(st: int) -> int {
    if st >= 0 {
        return 0 - st
    }
    if st <= -256 {
        return 0 - st - 256
    }
    0 - st
}

/// The job first, then the ignore, as GNU's `timeout` orders them: a
/// meaning this program ignores is ignored in a child it starts after
/// (`[os.signal.disp]`), and the job must not be.
fn send_and_live(group: int, m: int, name: str) -> !int {
    let h = os_spawn(["sleep", "30"])?
    time_sleep_ms(100)
    os_signal_ignore_one(m)?
    os_signal_send_group(group, m)?
    let st = os_wait_status(h)?
    print("{name}: the job ended by signal {signal_of(st)}, this program lived")
    0
}

fn main() -> !int {
    let rt_text = conf("rt")
    let rt = rt_text.to_int()?
    os_set_pgid(0)?
    let me = os_pgid()?
    // Read before any signal is sent, after the first call lupin refuses
    // by name (`os_set_pgid`), so no row is called red without them.
    masks()
    let _ = send_and_live(me, 4194304, "segment_fault")?
    if rt > 0 {
        let _ = send_and_live(me, 0 - rt, "host {rt}")?
    }
    // Back to the default: the next one sent would end it.
    os_signal_default_one(4194304)?
    print("segment_fault: the default again")
    0
}
