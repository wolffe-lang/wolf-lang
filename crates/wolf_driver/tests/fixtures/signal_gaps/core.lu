//! member: false
//! s246 (wolf-lang#785, `[os.proc.status]`, `[os.proc.poll]`) — a child
//! that dumps core: `sh -c 'kill -s SEGV $$'` (and one ended by `TERM`,
//! which dumps none), reported as `os_wait_status` (`s246.how`, a file in
//! the working directory, `wait`) or `os_wait_poll` (`poll`) answers it. A core reads `-(256 + N)` since
//! s246 (it read `-N` before, as it still does without one). RUN ONLY
//! INSIDE A THROWAWAY CONTAINER whose working directory is the test's
//! own, with `ulimit -c` set by the test: a core is a file there.

/// One setting the test wrote beside the program, `s246.<name>` in the
/// working directory (not the environment: lupin's `conform-run` answers
/// `missing` for every variable), or "" when there is none.
fn conf(name: str) -> str {
    fs_read_text("s246.{name}") else |_| ""
}

fn status_of(h: int, how: str) -> !int {
    if how == "wait" {
        return os_wait_status(h)?
    }
    var r = os_wait_poll()?
    while r.0 != h {
        time_sleep_ms(5)
        r = os_wait_poll()?
    }
    r.1
}

fn main() -> !int {
    let how = conf("how")
    let segv = os_spawn(["sh", "-c", "kill -s SEGV $$"])?
    print("segv {status_of(segv, how)?}")
    let term = os_spawn(["sh", "-c", "kill -s TERM $$"])?
    print("term {status_of(term, how)?}")
    0
}
