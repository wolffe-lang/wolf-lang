        p.atomic_or(v, Order.acq_rel)
    }
}

export fn a_xor_u64_relaxed(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        p.atomic_xor(v, Order.relaxed)
    }
}

export fn a_xor_u64_acquire(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        p.atomic_xor(v, Order.acquire)
    }
}

export fn a_xor_u64_release(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        p.atomic_xor(v, Order.release)
    }
}

export fn a_xor_u64_acq_rel(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        p.atomic_xor(v, Order.acq_rel)
    }
}

export fn a_cas_u64_relaxed_relaxed(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        let (old, ok) = p.atomic_cas(v, v + 1, Order.relaxed, Order.relaxed)
        old
    }
}

export fn a_cas_u64_acquire_relaxed(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        let (old, ok) = p.atomic_cas(v, v + 1, Order.acquire, Order.relaxed)
        old
    }
}

export fn a_cas_u64_acquire_acquire(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        let (old, ok) = p.atomic_cas(v, v + 1, Order.acquire, Order.acquire)
        old
    }
}

export fn a_cas_u64_release_relaxed(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        let (old, ok) = p.atomic_cas(v, v + 1, Order.release, Order.relaxed)
        old
    }
}

export fn a_cas_u64_acq_rel_relaxed(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        let (old, ok) = p.atomic_cas(v, v + 1, Order.acq_rel, Order.relaxed)
        old
    }
}

export fn a_cas_u64_acq_rel_acquire(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        let (old, ok) = p.atomic_cas(v, v + 1, Order.acq_rel, Order.acquire)
        old
    }
}

export fn a_cas_u64_seq_cst_relaxed(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        let (old, ok) = p.atomic_cas(v, v + 1, Order.seq_cst, Order.relaxed)
        old
    }
}

export fn a_cas_u64_seq_cst_acquire(p: *u64, v: u64) -> u64 {
    // # Safety: the caller passes a live `*u64` aligned to its size.
    unsafe {
        let (old, ok) = p.atomic_cas(v, v + 1, Order.seq_cst, Order.acquire)
        old
    }
}

export fn f_acquire() {
    // # Safety: a fence touches no memory.
    unsafe {
        fence(Order.acquire)
    }
}

export fn f_release() {
    // # Safety: a fence touches no memory.
    unsafe {
        fence(Order.release)
    }
}

export fn f_acq_rel() {
    // # Safety: a fence touches no memory.
    unsafe {
        fence(Order.acq_rel)
    }
}

export fn f_seq_cst() {
    // # Safety: a fence touches no memory.
    unsafe {
        fence(Order.seq_cst)
    }
}

export fn spin_acquire(p: *u32) -> u32 {
    // # Safety: the caller passes a live, aligned `*u32` another task
    // sets.
    unsafe {
        while p.atomic_load(Order.acquire) == 0 {
        }
        p.atomic_load(Order.relaxed)
    }
}

export fn spin_lock(p: *u32) {
    // # Safety: the caller passes a live, aligned lock word.
    unsafe {
        loop {
            let (old, ok) = p.atomic_cas(0, 1, Order.acquire, Order.relaxed)
            if ok {
                break
            }
        }
    }
}

export fn spin_unlock(p: *u32) {
    // # Safety: as spin_lock; the caller holds the lock.
    unsafe {
        p.atomic_store(0, Order.release)
    }
}
