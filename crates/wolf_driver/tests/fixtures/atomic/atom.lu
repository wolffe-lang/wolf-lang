export fn a_cas_u8_seq_cst_seq_cst(p: *u8, v: u8) -> u8 {
    // # Safety: the caller passes a live `*u8` aligned to its size.
    unsafe {
        let (old, ok) = p.atomic_cas(v, v + 1, Order.seq_cst, Order.seq_cst)
        old
    }
}

