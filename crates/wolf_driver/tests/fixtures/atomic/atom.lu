// kw11 (`[conc.mm.atomic.raw.3]`, `[conc.mm.fence]`): the disassembly
// gate's functions, generated (one per row). Every function is an
// `export fn` (kw02): an unmangled global that `--release` keeps, so
// `atomic_disasm.rs` finds each by name and reads its instructions.
// `a_<op>_<T>_<order>` is one atomic operation through the pointer
// argument; `f_<order>` one fence; `spin_*` the scheduler's two loops
// (a spin on an acquire load, a test-and-set lock).

export fn a_load_u8_seq_cst(p: *u8, v: u8) -> u8 {
    // # Safety: the caller passes a live `*u8` aligned to its size.
    unsafe {
        p.atomic_load(Order.seq_cst)
    }
}

export fn a_store_u8_seq_cst(p: *u8, v: u8) {
    // # Safety: the caller passes a live `*u8` aligned to its size.
    unsafe {
        p.atomic_store(v, Order.seq_cst)
    }
}

export fn a_swap_u8_seq_cst(p: *u8, v: u8) -> u8 {
    // # Safety: the caller passes a live `*u8` aligned to its size.
    unsafe {
        p.atomic_swap(v, Order.seq_cst)
    }
}

export fn a_add_u8_seq_cst(p: *u8, v: u8) -> u8 {
    // # Safety: the caller passes a live `*u8` aligned to its size.
    unsafe {
        p.atomic_add(v, Order.seq_cst)
    }
}

