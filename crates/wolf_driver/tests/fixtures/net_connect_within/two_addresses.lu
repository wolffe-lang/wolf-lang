//! member: false
//! wolf-lang#1146: one budget covers every address a name resolves to,
//! tried in turn. The gate stages this program with the name to dial (one
//! that resolves to two distinct addresses here) and the address to listen
//! on (the second of them): the listener is there alone, the first refuses, and the
//! dial connects to the second inside its budget (10 s: windows retries a
//! refused loopback dial for about two seconds).

fn main() -> !int {
    let l = net_listen("@LISTEN@")?
    let port = net_port(l)?
    let c = net_connect_within("@NAME@:{port}", 10000)?
    print("connected")
    net_close(c)?
    net_close(l)?
    0
}
