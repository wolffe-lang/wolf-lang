// kw04: kmain.lu with one overflowing addition before the loop. The
// operand comes from outside (`kw_big` is rt_stub.S's i64::MAX), so no
// tier can fold the check away: the trap reaches `wolf_trap` with its
// site on both tiers, and the stub exits with the site's line.
extern "c" fn kw_outb(port: u16, v: byte)
extern "c" fn kw_big() -> i64

export fn kmain() -> i64 {
    // # Safety: kw_big is rt_stub.S's constant.
    let n = unsafe { kw_big() }
    let m = n + 1 // TRAP-SITE
    let msg = "KWC\n"
    for b in msg.bytes() {
        // # Safety: kw_outb is rt_stub.S's port write; 0x3f8 is COM1.
        unsafe {
            kw_outb(1016, b)
        }
    }
    m
}
