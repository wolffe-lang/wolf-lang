;; @build_config
function u0:0() -> i64 system_v {
    ss0 = explicit_slot 8, align = 8

block0:
    v0 = iconst.i64 42
    v1 = stack_addr.i64 ss0
    store notrap aligned v0, v1  ; v0 = 42
    v2 = load.i64 notrap aligned v1
    return v2
}

;; @main
function u0:1() -> i64 system_v {
    ss0 = explicit_slot 8, align = 8
    sig0 = () -> i64 system_v
    sig1 = () -> i64 system_v
    sig2 = (i64) system_v
    fn0 = u0:2 sig0
    fn1 = colocated u0:0 sig1
    fn2 = u0:3 sig2

block0:
    v1 = call fn0()
    v2 = call fn1()
    v3 = stack_addr.i64 ss0
    store notrap aligned v2, v3
    call fn2(v1)
    v4 = load.i64 notrap aligned v3
    v5 = iconst.i64 42
    v6 = icmp eq v4, v5  ; v5 = 42
    brif v6, block1, block2

block1:
    v7 = iconst.i64 0
    jump block3(v7)  ; v7 = 0

block2:
    v8 = iconst.i64 1
    jump block3(v8)  ; v8 = 1

block3(v0: i64):
    return v0
}
