;; @grow
function u0:0(i64, i64) system_v {
    ss0 = explicit_slot 8, align = 8
    ss1 = explicit_slot 8, align = 8
    ss2 = explicit_slot 16, align = 8
    sig0 = (i32) system_v
    fn0 = u0:3 sig0

block0(v0: i64, v1: i64):
    v2 = stack_addr.i64 ss0
    store notrap aligned v0, v2
    v3 = iconst.i64 2
    v4, v5 = smul_overflow v0, v3  ; v3 = 2
    brif v5, block1, block2

block2:
    v6 = stack_addr.i64 ss1
    store.i64 notrap aligned v4, v6
    v7 = stack_addr.i64 ss2
    v8 = iconst.i64 0
    v9 = iadd v7, v8  ; v8 = 0
    v10 = load.i64 notrap aligned v2
    store notrap aligned v10, v9
    v11 = iconst.i64 8
    v12 = iadd v7, v11  ; v11 = 8
    v13 = load.i64 notrap aligned v6
    store notrap aligned v13, v12
    v14 = load.i64 notrap aligned v7
    store notrap aligned v14, v1
    v15 = load.i64 notrap aligned v7+8
    store notrap aligned v15, v1+8
    return

block1 cold:
    v16 = iconst.i32 1
    call fn0(v16)  ; v16 = 1
    trap user1
}

;; @scale
function u0:1(i64, i64, i64) system_v {
    ss0 = explicit_slot 8, align = 8
    ss1 = explicit_slot 8, align = 8
    ss2 = explicit_slot 16, align = 8
    sig0 = (i32) system_v
    fn0 = u0:3 sig0

block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 0
    v4 = iadd v0, v3  ; v3 = 0
    v5 = load.i64 notrap aligned v4
    v6, v7 = smul_overflow v5, v1
    brif v7, block1, block2

block2:
    v8 = stack_addr.i64 ss0
    store.i64 notrap aligned v6, v8
    v9 = iconst.i64 8
    v10 = iadd.i64 v0, v9  ; v9 = 8
    v11 = load.i64 notrap aligned v10
    v12, v13 = smul_overflow v11, v1
    brif v13, block1, block3

block3:
    v14 = stack_addr.i64 ss1
    store.i64 notrap aligned v12, v14
    v15 = stack_addr.i64 ss2
    v16 = iconst.i64 0
    v17 = iadd v15, v16  ; v16 = 0
    v18 = load.i64 notrap aligned v8
    store notrap aligned v18, v17
    v19 = iconst.i64 8
    v20 = iadd v15, v19  ; v19 = 8
    v21 = load.i64 notrap aligned v14
    store notrap aligned v21, v20
    v22 = load.i64 notrap aligned v15
    store notrap aligned v22, v2
    v23 = load.i64 notrap aligned v15+8
    store notrap aligned v23, v2+8
    return

block1 cold:
    v24 = iconst.i32 1
    call fn0(v24)  ; v24 = 1
    trap user1
}

;; @main
function u0:2() -> i64 system_v {
    ss0 = explicit_slot 16, align = 8
    ss1 = explicit_slot 16, align = 8
    sig0 = (i64, i64) system_v
    sig1 = (i64, i64, i64) system_v
    sig2 = (i32) system_v
    fn0 = colocated u0:0 sig0
    fn1 = colocated u0:1 sig1
    fn2 = u0:3 sig2

block0:
    v1 = iconst.i64 3
    v2 = stack_addr.i64 ss0
    call fn0(v1, v2)  ; v1 = 3
    v3 = iconst.i64 7
    v4 = stack_addr.i64 ss1
    call fn1(v2, v3, v4)  ; v3 = 7
    v5 = iconst.i64 0
    v6 = iadd v4, v5  ; v5 = 0
    v7 = load.i64 notrap aligned v6
    v8 = iconst.i64 8
    v9 = iadd v4, v8  ; v8 = 8
    v10 = load.i64 notrap aligned v9
    v11, v12 = sadd_overflow v7, v10
    brif v12, block4, block5

block5:
    v13 = iconst.i64 63
    v14 = icmp.i64 eq v11, v13  ; v13 = 63
    brif v14, block1, block2

block1:
    v15 = iconst.i64 0
    jump block3(v15)  ; v15 = 0

block2:
    v16 = iconst.i64 1
    jump block3(v16)  ; v16 = 1

block3(v0: i64):
    return v0

block4 cold:
    v17 = iconst.i32 1
    call fn2(v17)  ; v17 = 1
    trap user1
}
