pub fn len(b: List[byte]) -> int {
    b.len
}

pub fn is_empty(b: List[byte]) -> bool {
    b.len == 0
}

pub fn at(b: List[byte], i: int) -> int {
    b[i] as int
}

pub fn slice(b: List[byte], from: int, to: int) -> List[byte] {
    let n = b.len
    if from < 0 {
        assert(false, "bytes.slice: the start cannot be negative")
    }
    if to < from {
        assert(false, "bytes.slice: the range is out of order")
    }
    if to > n {
        assert(false, "bytes.slice: the range ends past the last byte")
    }
    var out = List[byte]()
    var k = from
    while k < to {
        (mut out).push(b[k])
        k = k + 1
    }
    out
}

pub fn find(b: List[byte], needle: List[byte]) -> int ! {none} {
    let n = b.len
    let m = needle.len
    if m == 0 {
        return 0
    }
    if m > n {
        return none
    }
    var i = 0
    while i <= n - m {
        var k = 0
        var same = true
        while k < m {
            if b[i + k] != needle[k] {
                same = false
                k = m
            } else {
                k = k + 1
            }
        }
        if same {
            return i
        }
        i = i + 1
    }
    return none
}

pub fn starts_with(b: List[byte], prefix: List[byte]) -> bool {
    let n = b.len
    let m = prefix.len
    if m > n {
        return false
    }
    var i = 0
    while i < m {
        if b[i] != prefix[i] {
            return false
        }
        i = i + 1
    }
    true
}

pub fn ends_with(b: List[byte], suffix: List[byte]) -> bool {
    let n = b.len
    let m = suffix.len
    if m > n {
        return false
    }
    var i = 0
    while i < m {
        if b[n - m + i] != suffix[i] {
            return false
        }
        i = i + 1
    }
    true
}

pub fn from_str(s: str) -> List[byte] {
    s.bytes()
}

pub fn to_str(b: List[byte]) -> str ! {utf8} {
    str_from_utf8(b)?
}

pub fn is_utf8(b: List[byte]) -> bool {
    let n = b.len
    var i = 0
    while i < n {
        let b0 = b[i] as int
        if b0 < 0 {
            return false
        } else if b0 < 128 {
            i = i + 1
        } else if b0 < 194 {
            return false
        } else if b0 < 224 {
            if i + 1 >= n {
                return false
            }
            if !is_cont(b[i + 1] as int) {
                return false
            }
            i = i + 2
        } else if b0 < 240 {
            if i + 2 >= n {
                return false
            }
            let b1 = b[i + 1] as int
            if !is_cont(b1) || !is_cont(b[i + 2] as int) {
                return false
            }
            if b0 == 224 && b1 < 160 {
                return false
            }
            if b0 == 237 && b1 > 159 {
                return false
            }
            i = i + 3
        } else if b0 < 245 {
            if i + 3 >= n {
                return false
            }
            let b1 = b[i + 1] as int
            if !is_cont(b1) || !is_cont(b[i + 2] as int) || !is_cont(b[i + 3] as int) {
                return false
            }
            if b0 == 240 && b1 < 144 {
                return false
            }
            if b0 == 244 && b1 > 143 {
                return false
            }
            i = i + 4
        } else {
            return false
        }
    }
    true
}

fn is_cont(x: int) -> bool {
    x > 127 && x < 192
}
