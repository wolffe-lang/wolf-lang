}

fn @main() -> i64 {
b0:
  %0: ptr, %1: mem.r0 = region.new
  %2 = iconst.i64 32
  %3: ptr, %4: mem.r0 = region.alloc %0, %2, %1
  %5 = iconst.i64 64
